                            GestureView{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} on_tap: |x, y| pick_lang(14)
                                Label{width: Fill text: "Bahasa Indonesia" draw_text.color: ink draw_text.text_style.font_size: 15}}
                            GestureView{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} on_tap: |x, y| pick_lang(15)
                                Label{width: Fill text: "ไทย" draw_text.color: ink draw_text.text_style.font_size: 15}}
                            GestureView{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} on_tap: |x, y| pick_lang(16)
                                Label{width: Fill text: "Nederlands" draw_text.color: ink draw_text.text_style.font_size: 15}}
                            GestureView{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} on_tap: |x, y| pick_lang(17)
                                Label{width: Fill text: "Polski" draw_text.color: ink draw_text.text_style.font_size: 15}}
                            GestureView{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} on_tap: |x, y| pick_lang(18)
                                Label{width: Fill text: "Other" draw_text.color: ink draw_text.text_style.font_size: 15}}
                        }
                    }
                    lang_custom := View{visible: false width: Fill height: Fit
                        custom_field := TextInput{width: Fill height: 40 empty_text: "Language name" on_change: |text| save_custom(text)
                            draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7
                                border_color: #x00000000 border_radius: 10.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary}}
                    }
                    Label{width: Fill text: "Recognize and Translate use this language. If the mail is already in it, the text stays as it is." draw_text.color: secondary draw_text.text_style.font_size: 12}
                }
            }
            confirm := GestureView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.5} on_tap: |x, y| cancel_remove()
                draw_bg.color: #x66000000
                GestureView{width: 320 height: Fit on_tap: |x, y| { }
                    SolidView{width: Fill height: Fit flow: Down padding: 20 spacing: 12 draw_bg.color: #xffffff
                        Label{text: "Remove this account?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                        confirm_name := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 14}
                        View{width: Fill height: Fit flow: Right
                            Bar{text: "Cancel" on_click: || cancel_remove()}
                            View{width: Fill height: 1}
                            ButtonFlat{text: "Remove" height: 36 padding: Inset{left: 12 right: 12} on_click: || confirm_remove()
                                draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
                                draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style +: {font_size: 15}}}
                        }
                    }
                }
            }
            rename_catch := GestureView{visible: false width: Fill height: Fill on_tap: |x, y| commit_rename()}
        }
        agent_slim := SolidView{width: 44 height: Fill flow: Overlay draw_bg.color: rail_bg
            SolidView{width: 1 height: Fill draw_bg.color: #xe5e5ea}
            View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                GestureView{width: 28 height: 28 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| toggle_agent()
                    Label{text: "‹" draw_text.color: secondary draw_text.text_style.font_size: 16}
                }
            }
        }
        agent_panel := SolidView{visible: false width: 320 height: Fill flow: Right draw_bg.color: #xfafafa
            SolidView{width: 1 height: Fill draw_bg.color: #xe5e5ea}
            View{width: 22 height: Fill align: Align{x: 0.5 y: 0.5}
                GestureView{width: 22 height: 36 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| toggle_agent()
                    Label{text: "›" draw_text.color: secondary draw_text.text_style.font_size: 16}
                }
            }
            View{width: Fill height: Fill flow: Down padding: Inset{right: 12 top: 8 bottom: 10} spacing: 8
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                    Label{text: "Agent" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                    View{width: Fill height: 1}
                    ButtonFlat{text: "🕐" width: 36 height: 36 padding: Inset{left: 0 right: 0 top: 0 bottom: 0} on_click: || toggle_history()
                        draw_bg +: {color: #x00000000 color_hover: #x00000014 color_down: #x00000022 border_size: 0.0 border_radius: 18.0}
                        draw_text +: {color: secondary color_hover: ink color_down: ink text_style +: {font_size: 18}}}
                }
                View{width: Fill height: Fill flow: Overlay
                    agent_chat := View{width: Fill height: Fill flow: Down spacing: 8
                chat_view := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
                    if chat_log.len() == 0 {
                        Label{width: Fill text: "Ask about the open message. Say all mail or a time period to use those instead." draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                    for m in chat_log {
                        if m.role == "user" {
                            Label{width: Fill text: m.text draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        } else {
                            Label{width: Fill text: m.text draw_text.color: ink draw_text.text_style.font_size: 14}
                        }
                    }
                }}
                agent_note := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 4
                    agent_input := TextInput{width: Fill height: 40 empty_text: "Ask" on_change: |text| pending_input = text on_return: |text| ask_agent(text)
                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #ffffff color_empty: #xffffff
                            border_color: #xe5e5ea border_color_hover: #xe5e5ea border_color_focus: accent border_color_empty: #xe5e5ea border_radius: 10.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
                    }
                    Bar{text: "Send" height: 40 padding: Inset{left: 6 right: 0} on_click: || ask_agent("")}
                }
                    }
                    history_pane := SolidView{visible: false width: Fill height: Fill flow: Down spacing: 8 draw_bg.color: #xfafafa
                        Bar{text: "New chat" on_click: || new_chat()}
                        history_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 4 on_render: || {
                            if sessions.len() == 0 {
                                Label{width: Fill text: "No earlier chats yet." draw_text.color: secondary draw_text.text_style.font_size: 13}
                            }
                            for i in sessions.len() {
                                let s = sessions[i]
                                GestureView{width: Fill height: Fit padding: Inset{top: 8 bottom: 8} on_tap: |x, y| restore_session(i)
                                    Label{width: Fill text: s.title max_lines: 2 draw_text.color: ink draw_text.text_style.font_size: 14}
                                }
                                SolidView{width: Fill height: 1 draw_bg.color: #xe5e5ea}
                            }
                        }}
                    }
                    agent_catch := GestureView{visible: false width: Fill height: Fill on_tap: |x, y| commit_rename()}
                }
            }
        }
    }
    draft_sheet := GestureView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.5} on_tap: |x, y| close_draft_sheet()
        draw_bg.color: #x66000000
        GestureView{width: 360 height: Fit on_tap: |x, y| { }
            SolidView{width: Fill height: Fit flow: Down padding: 20 spacing: 12 draw_bg +: {color: #xffffffff border_radius: 14.0}
                Label{text: "What should this say?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                draft_idea := TextInput{width: Fill height: 96 empty_text: "Let AI decide" on_return: |text| send_draft_idea()
                    draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7
                        border_color: #x00000000 border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary}}
                View{width: Fill height: Fit flow: Right
                    Bar{text: "Cancel" on_click: || close_draft_sheet()}
                    View{width: Fill height: 1}
                    Bar{text: "Send" on_click: || send_draft_idea()}
                }
            }
        }
    }
}
