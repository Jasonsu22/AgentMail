let accounts = []
let account = nil          // {id, address}
let messages = []
let total = 0
let open_id = ""
let reading = nil
let busy = false
let folder = {id: "INBOX" name: "Inbox"}
let folders_by = {}
let open_by = {}
let names = {}
let renaming = ""
let rename_text = ""
let rail_open = true
let agent_open = false
let agent_scope = "message"
let agent_busy = false
let settings_tab = "account"
let pending_remove = ""
let chat_log = []

fn status(text){ ui.status.set_text(text) }
fn pane(name){
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
}
fn show_reader(){
    ui.r_ai.set_visible(false)
    ui.r_ai.set_text("")
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(true)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
}
fn show_composer(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(true)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
}
fn close_detail(){
    commit_rename()
    reading = nil
    open_id = ""
    pending_remove = ""
    ui.list_pane.set_visible(true)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
}
fn toggle_rail(){
    rail_open = !rail_open
    ui.rail_slot.render()
}
fn local_part(address){
    if address == nil { return "" }
    let bits = address.split("@")
    if bits.len() > 0 && bits[0] != "" { return bits[0] }
    return address
}
fn display_name(a){
    let custom = names[a.id]
    if custom != nil && custom != "" { return custom }
    return local_part(a.address)
}
fn load_prefs(){
    if fs.exists("names.txt") {
        let lines = fs.read("names.txt").split("\n")
        for line in lines {
            let bits = line.split("|")
            if bits.len() >= 2 && bits[0] != "" { names[bits[0]] = bits[1] }
        }
    }
}
fn save_names(){
    let text = ""
    for a in accounts {
        let custom = names[a.id]
        if custom != nil && custom != "" {
            if text != "" { text = text + "\n" }
            text = text + a.id + "|" + custom
        }
    }
    fs.write("names.txt", text)
}
fn begin_rename(id){
    renaming = id
    rename_text = ""
    for a in accounts {
        if a.id == id { rename_text = display_name(a) }
    }
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn commit_rename(){
    if renaming == "" { return }
    finish_rename(renaming, rename_text)
}
fn finish_rename(id, text){
    names[id] = text.trim()
    renaming = ""
    rename_text = ""
    save_names()
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn is_open(id){
    if open_by[id] == nil { return true }
    return open_by[id]
}
fn show_heading(){
    ui.title.set_text(folder.name)
    if account == nil { ui.address.set_text("") }
    else { ui.address.set_text(account.address) }
}
fn load_accounts(){
    host.request("mail.accounts", {}, fn(r){
        if r.is_ok && r.data.len() > 0 {
            accounts = r.data
            let keep = false
            if account != nil {
                for a in accounts { if a.id == account.id { keep = true } }
            }
            if !keep {
                account = accounts[0]
                folder = {id: "INBOX" name: "Inbox"}
            }
            pane("inbox")
            show_heading()
            ui.rail_slot.render()
            for a in accounts {
                if open_by[a.id] == nil { open_by[a.id] = true }
                load_folders(a.id)
            }
            list()
            sync()
            if ui.settings_pane.visible() { ui.settings_accounts.render() }
        } else {
            accounts = []
            account = nil
            messages = []
            pane("welcome")
        }
    })
}
fn add_account(){
    status("Sign in on the sheet OctoSense shows.")
    ui.welcome_note.set_text("Sign in on the sheet OctoSense shows.")
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { load_accounts() }
        else {
            status(r.error)
            ui.welcome_note.set_text(r.error)
        }
    })
}
fn toggle_account(id){
    open_by[id] = !is_open(id)
    ui.rail_slot.render()
}
fn load_folders(id){
    host.request("mail.folders", {account: id}, fn(r){
        if r.is_ok {
            folders_by[id] = r.data
            ui.rail_slot.render()
        }
    })
}
fn select_folder(a, f){
    account = a
    folder = f
    messages = []
    close_detail()
    show_heading()
    ui.rail_slot.render()
    ui.rows.render()
    list()
    sync()
}
fn sync(){
    if account == nil || busy { return }
    busy = true
    status("Checking for mail…")
    host.request("mail.sync", {account: account.id folder: folder.id}, fn(r){
        busy = false
        if r.is_ok {
            if r.data.new == 1 { status("1 new message") }
            else if r.data.new > 0 { status("" + r.data.new + " new messages") }
            else { status("Up to date") }
            list()
        } else { status(r.error) }
    })
}
fn list(){
    if account == nil { return }
    host.request("mail.list", {account: account.id folder: folder.id offset: 0 limit: 100}, fn(r){
        if r.is_ok {
            messages = r.data.messages
            total = r.data.total
            ui.rows.render()
        } else { status(r.error) }
    })
}
fn open_message(m){
    open_id = m.id
    host.request("mail.message", {account: account.id folder: folder.id message: m.id}, fn(r){
        if r.is_ok {
            reading = r.data
            ui.r_subject.set_text(r.data.subject)
            ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
            ui.r_time.set_text(r.data.time)
            // Formatted mail shows as the host rebuilt it: text, links and
            // lists, nothing remote.
            let formatted = r.data.html != ""
            ui.r_html.set_visible(formatted)
            ui.r_body.set_visible(!formatted)
            if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_body.set_text(r.data.body) }
            let names = ""
            for a in r.data.attachments {
                if names != "" { names = names + ", " }
                names = names + a.filename + " (" + kb(a.size) + ")"
            }
            ui.r_attachments.set_visible(names != "")
            ui.r_attachments.set_text("Attachments: " + names)
            show_reader()
            m.unread = false
            host.request("mail.mark_read", {account: account.id folder: folder.id message: m.id}, fn(done){
                if !done.is_ok { status(done.error) }
            })
        } else { status(r.error) }
    })
}
fn compose(to, subject, body){
    ui.c_to.set_text(to)
    ui.c_subject.set_text(subject)
    ui.c_body.set_text(body)
    ui.c_note.set_text("")
    show_composer()
}
fn reply(){
    if reading == nil { return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    compose(reading.address, subject, "\n\n> " + reading.body.replace("\n", "\n> "))
}
fn send(){
    if account == nil { return }
    ui.c_note.set_text("Sending…")
    host.request("mail.send", {account: account.id to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text()}, fn(r){
        if r.is_ok { status("Sent"); close_detail(); ui.rows.render() } else { ui.c_note.set_text(r.error) }
    })
}
fn remove_account(id){
    if id == "" { return }
    host.request("mail.remove_account", {account: id}, fn(r){
        if r.is_ok { load_accounts() } else { status(r.error) }
    })
}
fn ask_remove(a){
    commit_rename()
    pending_remove = a.id
    ui.confirm_name.set_text(display_name(a))
    ui.confirm.set_visible(true)
}
fn cancel_remove(){
    pending_remove = ""
    ui.confirm.set_visible(false)
}
fn confirm_remove(){
    let id = pending_remove
    pending_remove = ""
    ui.confirm.set_visible(false)
    remove_account(id)
}
fn show_tab(name){
    commit_rename()
    settings_tab = name
    ui.account_tab.set_visible(name == "account")
    ui.agent_tab.set_visible(name == "agent")
    if name == "agent" { refresh_provider() }
    ui.settings_accounts.render()
}
fn show_settings(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(true)
    ui.confirm.set_visible(false)
    show_tab("account")
}
fn open_settings(){
    commit_rename()
    if ui.settings_pane.visible() { close_detail(); return }
    show_settings()
}
fn back_to_inbox(){ close_detail(); ui.rows.render() }
fn kb(n){
    if n > 1000000 { return "" + floor(n / 100000) / 10 + " MB" }
    return "" + (floor(n / 1000) + 1) + " KB"
}
fn folder_selected(a, f){
    if account == nil { return false }
    return account.id == a.id && folder.id == f.id
}

fn toggle_agent(){
    agent_open = !agent_open
    ui.agent_slim.set_visible(!agent_open)
    ui.agent_panel.set_visible(agent_open)
}
fn answer_schema(){
    return {type: "object" required: ["answer"] additionalProperties: false
        properties: {answer: {type: "string" minLength: 1 maxLength: 4000}}}
}
fn take_answer(r){
    if !r.is_ok { return r.error }
    if r.data != nil && r.data.output != nil && r.data.output.answer != nil {
        return r.data.output.answer
    }
    return "The model returned no answer."
}
fn refresh_provider(){
    ui.api_status.set_text("Testing the connection…")
    host.request("model.complete", {
        task: "Reply with the word ok."
        input: {ping: "ok"}
        schema: answer_schema()
        class: "fast"
    }, fn(s){
        if s.is_ok { ui.api_status.set_text("Connected · using the model in AI providers") }
        else { ui.api_status.set_text(s.error) }
    })
}
fn set_scope(name){
    agent_scope = name
    if name == "mailbox" { ui.scope_note.set_text("Inbox already on this device") }
    else { ui.scope_note.set_text("The open message") }
}
fn clip(text, n){
    if text == nil { return "" }
    if text.len() <= n { return text }
    let lines = text.split("\n")
    let out = ""
    for line in lines {
        if (out + line).len() > n {
            if out == "" { return "…" }
            return out + "\n…"
        }
        if out != "" { out = out + "\n" }
        out = out + line
    }
    return out
}
fn message_context(){
    if reading == nil { return "No message is open. Say that you cannot see a message." }
    return "Subject: " + reading.subject + "\nFrom: " + reading.sender + " <" + reading.address + ">\nDate: " + reading.time + "\n\n" + clip(reading.body, 6000)
}
fn mailbox_digest(list, title){
    let t = "Account: " + account.address + "\n" + title + "\nThese are messages already on this device, not the full mailbox history.\n"
    let n = list.len()
    if n > 24 { n = 24 }
    for i in n {
        let m = list[i]
        let preview = ""
        if m.preview != nil { preview = clip(m.preview, 80) }
        t = t + "- " + m.time + " | " + m.sender + " | " + m.subject + " | " + preview + "\n"
    }
    if n == 0 { t = t + "(no messages)\n" }
    return clip(t, 8000)
}
fn history_text(){
    let t = ""
    let start = 0
    if chat_log.len() > 8 { start = chat_log.len() - 8 }
    for i in chat_log.len() {
        if i >= start {
            let m = chat_log[i]
            t = t + m.role + ": " + clip(m.text, 800) + "\n"
        }
    }
    return t
}
fn finish_turn(text){
    agent_busy = false
    ui.agent_note.set_text("")
    chat_log.push({role: "agent" text: text})
    ui.chat_view.render()
}
fn run_turn(context, question){
    host.request("model.complete", {
        task: "You are AgentMail. Answer using only the mail context. If it is not enough, say so. Do not invent messages. Reply in the user's language. Put the whole reply in answer."
        input: {mail: clip(context, 8000) history: clip(history_text(), 2500) question: question}
        schema: answer_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        finish_turn(take_answer(r))
    })
}
fn ask_agent(){
    if agent_busy || account == nil { return }
    let q = ui.agent_input.text().trim()
    if q == "" { return }
    ui.agent_input.set_text("")
    chat_log.push({role: "user" text: q})
    ui.chat_view.render()
    agent_busy = true
    ui.agent_note.set_text("Thinking…")
    if agent_scope == "mailbox" {
        host.request("mail.list", {account: account.id folder: "INBOX" offset: 0 limit: 30}, fn(r){
            if r.is_ok { run_turn(mailbox_digest(r.data.messages, "Inbox"), q) }
            else if messages.len() > 0 { run_turn(mailbox_digest(messages, folder.name), q) }
            else { run_turn("No messages are loaded for this account.", q) }
        })
    } else {
        run_turn(message_context(), q)
    }
}
fn use_draft(){
    let text = ""
    for m in chat_log { if m.role == "agent" { text = m.text } }
    if text == "" { ui.agent_note.set_text("Ask a question first."); return }
    let to = ""
    let subject = ""
    if reading != nil {
        to = reading.address
        subject = reading.subject
        if subject.search("Re:") != 0 { subject = "Re: " + subject }
    }
    compose(to, subject, text)
}
fn ai_summarize(){
    if reading == nil { return }
    ui.r_ai.set_visible(true)
    ui.r_ai.set_text("Summarizing...")
    host.request("model.complete", {
        task: "Summarize this email in one sentence. Put the sentence in answer."
        input: {subject: reading.subject from: reading.sender body: clip(reading.body, 6000)}
        schema: answer_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        ui.r_ai.set_text(take_answer(r))
    })
}

start_timeout(0.05, || { load_prefs(); load_accounts() })

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x007aff
let rail_bg = #xf2f2f7
let Bar = ButtonFlat{height: 36 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}
}
let Field = TextInput{width: Fill height: 40
    draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
}
let Row = GestureView{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 10} spacing: 2
    top := View{width: Fill height: Fit flow: Right
        sender := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
        time := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    subject := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style.font_size: 14}
    preview := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 13}
}
let RowRead = Row{top +: {sender +: {draw_text.text_style: theme.font_regular{font_size: 15}}}}

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #xffffff
    welcome := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 12 padding: 32
        Label{text: "AgentMail" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 32}}
        Label{width: Fill align: Align{x: 0.5} text: "Add an account to read and send mail. OctoSense keeps your password; AgentMail never sees it."
            draw_text.color: secondary draw_text.text_style.font_size: 13}
        ButtonFlat{text: "Add account" height: 44 padding: Inset{left: 22 right: 22} on_click: || add_account()
            draw_bg +: {border_radius: 22.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 15}}}
        welcome_note := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    inbox := View{visible: false width: Fill height: Fill flow: Right
        rail_slot := View{width: Fit height: Fill on_render: || {
            if rail_open {
                SolidView{width: 220 height: Fill flow: Right draw_bg.color: rail_bg
                    View{width: Fill height: Fill flow: Down
                        ScrollYView{width: Fill height: Fill flow: Down padding: Inset{top: 14 bottom: 8}
                            for a in accounts {
                                let glyph = "▸"
                                if is_open(a.id) { glyph = "▾" }
                                GestureView{width: Fill height: Fit flow: Right align: Align{y: 0.0} padding: Inset{left: 4 right: 8 top: 8 bottom: 8} spacing: 4
                                    GestureView{width: 28 height: 22 align: Align{x: 0.5 y: 0.0} on_tap: |x, y| toggle_account(a.id)
                                        Label{text: glyph align: Align{x: 0.5} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                                    }
                                    Label{width: Fill text: display_name(a) max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                                }
                                if is_open(a.id) {
                                    let found = folders_by[a.id]
                                    if found == nil {
                                        Label{padding: Inset{left: 28} text: "Loading…" draw_text.color: secondary draw_text.text_style.font_size: 12}
                                    } else for f in found {
                                        if folder_selected(a, f) {
                                            GestureView{width: Fill height: 32 flow: Right align: Align{y: 0.5} padding: Inset{left: 28 right: 8} on_tap: |x, y| { commit_rename(); select_folder(a, f) }
                                                Label{width: Fill text: f.name max_lines: 1 draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 14}}
                                            }
                                        } else {
                                            GestureView{width: Fill height: 32 flow: Right align: Align{y: 0.5} padding: Inset{left: 28 right: 8} on_tap: |x, y| { commit_rename(); select_folder(a, f) }
                                                Label{width: Fill text: f.name max_lines: 1 draw_text.color: ink draw_text.text_style.font_size: 14}
                                            }
                                        }
                                    }
                                }
                            }
                            GestureView{width: Fill height: Fill on_tap: |x, y| commit_rename()}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 bottom: 10} spacing: 2
                            ButtonFlat{text: "Add account" width: Fill height: 36 on_click: || { commit_rename(); add_account() }
                                draw_bg +: {color: #x00000000 color_hover: #x00000018 color_down: #x00000028 border_size: 0.0 border_radius: 8.0}
                                draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 14}}}
                            ButtonFlat{text: "⚙️" width: 40 height: 40 padding: Inset{left: 0 right: 0 top: 0 bottom: 0} on_click: || open_settings()
                                draw_bg +: {color: #x00000000 color_hover: #x00000014 color_down: #x00000022 color_empty: #x00000000 color_focus: #x00000000 border_size: 0.0 border_radius: 20.0}
                                draw_text +: {color: secondary color_hover: secondary color_down: ink text_style +: {font_size: 17}}}
                        }
                    }
                    View{width: 22 height: Fill align: Align{x: 0.5 y: 0.5}
                        GestureView{width: 22 height: 36 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| { commit_rename(); toggle_rail() }
                            Label{text: "‹" draw_text.color: secondary draw_text.text_style.font_size: 16}
                        }
                    }
                }
            } else {
                SolidView{width: 44 height: Fill flow: Down draw_bg.color: rail_bg
                    View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                        GestureView{width: 28 height: 28 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| toggle_rail()
                            Label{text: "›" draw_text.color: secondary draw_text.text_style.font_size: 16}
                        }
                    }
                    View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{bottom: 12} spacing: 8
                        View{width: 40 height: 44 flow: Overlay
                            View{width: 40 height: 40 align: Align{x: 0.5 y: 0.5}
                                Label{text: "+" align: Align{x: 0.5 y: 0.5} draw_text.color: accent draw_text.text_style.font_size: 25}
                            }
                            View{width: 40 height: 47 padding: Inset{top: 10}
                                ButtonFlat{width: Fill height: Fill text: "" on_click: || add_account()
                                    draw_bg +: {color: #x00000000 color_hover: #x00000010 color_down: #x00000018 border_size: 0.0 border_radius: 50.0}
                                    draw_text +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000}}
                            }
                        }
                        ButtonFlat{text: "⚙️" width: 40 height: 40 padding: Inset{left: 0 right: 0 top: 0 bottom: 0} on_click: || open_settings()
                            draw_bg +: {color: #x00000000 color_hover: #x00000014 color_down: #x00000022 color_empty: #x00000000 color_focus: #x00000000 border_size: 0.0 border_radius: 20.0}
                            draw_text +: {color: secondary color_hover: secondary color_down: ink text_style +: {font_size: 20}}}
                    }
                }
            }
        }}
        View{width: Fill height: Fill flow: Overlay
            list_pane := View{width: Fill height: Fill flow: Down
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
                    Bar{text: "Refresh" on_click: || sync()}
                    View{width: Fill height: 1}
                    Bar{text: "Compose" on_click: || compose("", "", "")}
                }
                View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 bottom: 6} spacing: 2
                    title := Label{text: "Inbox" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
                    address := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                    status := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                }
                rows := ScrollYView{width: Fill height: Fill flow: Down on_render: || {
                    if messages.len() == 0 {
                        View{width: Fill height: 160 align: Align{x: 0.5 y: 0.5}
                            Label{text: "No mail yet." draw_text.color: secondary draw_text.text_style.font_size: 13}}
                    }
                    else for m in messages {
                        if m.unread {
                            Row{on_tap: |x, y| open_message(m) top.sender.text: m.sender top.time.text: m.time subject.text: m.subject preview.text: m.preview}
                        } else {
                            RowRead{on_tap: |x, y| open_message(m) top.sender.text: m.sender top.time.text: m.time subject.text: m.subject preview.text: m.preview}
                        }
                        Hr{}
                    }
                }}
            }
            reader := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
            Bar{text: "‹ Back" on_click: || back_to_inbox()}
            View{width: Fill height: 1}
            Bar{text: "Summarize" on_click: || ai_summarize()}
            Bar{text: "Reply" on_click: || reply()}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 6
            r_subject := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            r_sender := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
            r_time := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            r_ai := Label{visible: false width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
            Hr{}
            r_attachments := Label{visible: false width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            r_body := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 15}
            r_html := Html{visible: false width: Fill height: Fit padding: 0 font_color: ink font_size: 15
                draw_text +: {color: ink}
                text_style_normal +: {font_size: 15} text_style_bold +: {font_size: 15}
                text_style_italic +: {font_size: 15} text_style_bold_italic +: {font_size: 15} text_style_fixed +: {font_size: 14}}
        }
    }
    composer := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #ffffff padding: Inset{left: 12 right: 12 top: 8} spacing: 8
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Bar{text: "Cancel" on_click: || back_to_inbox()}
            View{width: Fill height: 1}
            Bar{text: "Send" on_click: || send()}
        }
        c_to := Field{empty_text: "To"}
        c_subject := Field{empty_text: "Subject"}
        c_body := Field{height: 260 empty_text: "Message"}
        c_note := Label{width: Fill text: "" draw_text.color: #xff3b30 draw_text.text_style.font_size: 12}
    }
            settings_pane := SolidView{visible: false width: Fill height: Fill flow: Down draw_bg.color: #xffffff padding: Inset{left: 16 right: 16 top: 8 bottom: 16} spacing: 12
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                    Bar{text: "‹ Back" on_click: || close_detail()}
                    View{width: Fill height: 1}
                    Label{text: "Settings" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                }
                View{width: Fill height: Fit flow: Right
                    Bar{text: "Accounts" on_click: || show_tab("account")}
                    Bar{text: "Agent" on_click: || show_tab("agent")}
                }
                account_tab := View{width: Fill height: Fill flow: Down spacing: 8
                    settings_accounts := ScrollYView{width: Fill height: Fill flow: Down spacing: 0 on_render: || {
                        if accounts.len() == 0 {
                            Label{text: "No accounts yet." draw_text.color: secondary draw_text.text_style.font_size: 13}
                        }
                        for a in accounts {
                            View{width: Fill height: Fit flow: Down spacing: 0
                                View{width: Fill height: Fit flow: Right align: Align{y: 0.0} padding: Inset{top: 8 bottom: 2} spacing: 8
                                    View{width: Fill height: Fit flow: Down spacing: 2
                                        if renaming == a.id {
                                            TextInput{width: Fill height: 34 text: rename_text empty_text: "Name" on_change: |text| rename_text = text on_return: |text| finish_rename(a.id, text)
                                                draw_bg +: {color: #xf2f2f7 border_radius: 6.0}
                                                draw_text +: {color: ink text_style +: {font_size: 15}}}
                                        } else {
                                            GestureView{width: Fill height: Fit on_double_tap: |x, y| begin_rename(a.id)
                                                Label{width: Fill text: display_name(a) max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                            }
                                        }
                                        GestureView{width: Fill height: Fit on_tap: |x, y| commit_rename()
                                            Label{width: Fill text: a.address max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 12}
                                        }
                                    }
                                    ButtonFlat{text: "Remove" height: 32 padding: Inset{left: 12 right: 12} on_click: || ask_remove(a)
                                        draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
                                        draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style +: {font_size: 14}}}
                                }
                                SolidView{width: Fill height: 1 draw_bg.color: #xe5e5ea}
                            }
                        }
                        GestureView{width: Fill height: Fill on_tap: |x, y| commit_rename()}
                    }}
                }
                agent_tab := View{visible: false width: Fill height: Fill flow: Down spacing: 10
                    Label{text: "API" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{width: Fill text: "AgentMail does not take an API key. Add your provider in OctoSense: Start → Settings → AI providers. The key stays on this device."
                        draw_text.color: secondary draw_text.text_style.font_size: 13}
                    api_status := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                    Bar{text: "Test connection" on_click: || refresh_provider()}
                }
            }
            confirm := GestureView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.5} on_tap: |x, y| cancel_remove()
                draw_bg.color: #x66000000
                GestureView{width: 320 height: Fit on_tap: |x, y| { }
                    SolidView{width: Fill height: Fit flow: Down padding: 20 spacing: 12 draw_bg.color: #xffffff
                        Label{text: "Remove this account?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                        confirm_name := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 14}
                        View{width: Fill height: Fit flow: Right
                            Bar{text: "Cancel" on_click: || cancel_remove()}
                            View{width: Fill height: 1}
                            ButtonFlat{text: "Remove" height: 36 padding: Inset{left: 12 right: 12} on_click: || confirm_remove()
                                draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
                                draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style +: {font_size: 15}}}
                        }
                    }
                }
            }
            rename_catch := GestureView{visible: false width: Fill height: Fill on_tap: |x, y| commit_rename()}
        }
        agent_slim := SolidView{width: 44 height: Fill flow: Overlay draw_bg.color: rail_bg
            SolidView{width: 1 height: Fill draw_bg.color: #xe5e5ea}
            View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                GestureView{width: 28 height: 28 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| toggle_agent()
                    Label{text: "‹" draw_text.color: secondary draw_text.text_style.font_size: 16}
                }
            }
        }
        agent_panel := SolidView{visible: false width: 320 height: Fill flow: Right draw_bg.color: #xfafafa
            SolidView{width: 1 height: Fill draw_bg.color: #xe5e5ea}
            View{width: 22 height: Fill align: Align{x: 0.5 y: 0.5}
                GestureView{width: 22 height: 36 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| toggle_agent()
                    Label{text: "›" draw_text.color: secondary draw_text.text_style.font_size: 16}
                }
            }
            View{width: Fill height: Fill flow: Down padding: Inset{right: 12 top: 8 bottom: 10} spacing: 8
                Label{text: "Agent" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                View{width: Fill height: Fill flow: Overlay
                    agent_chat := View{width: Fill height: Fill flow: Down spacing: 8
                View{width: Fill height: Fit flow: Right
                    Bar{text: "This message" on_click: || set_scope("message")}
                    Bar{text: "Mailbox" on_click: || set_scope("mailbox")}
                }
                scope_note := Label{width: Fill text: "The open message" draw_text.color: secondary draw_text.text_style.font_size: 12}
                chat_view := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
                    if chat_log.len() == 0 {
                        Label{width: Fill text: "Ask about the open message, or switch to the mailbox." draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                    for m in chat_log {
                        if m.role == "user" {
                            Label{width: Fill text: m.text draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        } else {
                            Label{width: Fill text: m.text draw_text.color: ink draw_text.text_style.font_size: 14}
                        }
                    }
                }}
                agent_note := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                agent_input := TextInput{width: Fill height: 40 empty_text: "Ask" on_return: |text| ask_agent()
                    draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xffffff
                        border_color: #xe5e5ea border_color_hover: #xe5e5ea border_color_focus: accent border_color_empty: #xe5e5ea border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
                }
                View{width: Fill height: Fit flow: Right
                    Bar{text: "Ask" on_click: || ask_agent()}
                    View{width: Fill height: 1}
                    Bar{text: "Use as draft" on_click: || use_draft()}
                }
                    }
                    agent_catch := GestureView{visible: false width: Fill height: Fill on_tap: |x, y| commit_rename()}
                }
            }
        }
    }
}
