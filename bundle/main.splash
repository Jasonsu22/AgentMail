fn status(text){ ui.status.set_text(text) }
fn pane(name){
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
}
fn show_reader(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(true)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
    ui.todos_pane.set_visible(false)
    paint_mail()
}
fn show_composer(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(true)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
    ui.todos_pane.set_visible(false)
}
fn close_detail(){
    commit_rename()
    reading = nil
    open_id = ""
    pending_remove = ""
    ui.list_pane.set_visible(true)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
    ui.todos_pane.set_visible(false)
}
fn toggle_rail(){
    rail_open = !rail_open
    ui.rail_slot.render()
}
fn local_part(address){
    if address == nil { return "" }
    let bits = address.split("@")
    if bits.len() > 0 && bits[0] != "" { return bits[0] }
    return address
}
fn display_name(a){
    let custom = names[a.id]
    if custom != nil && custom != "" { return custom }
    return local_part(a.address)
}
fn load_prefs(){
    load_chats()
    load_tools()
    load_action_items()
    load_device_calendar_handles()
    load_classes()
    load_events()
    if fs.exists("names.txt") {
        let lines = fs.read("names.txt").split("\n")
        for line in lines {
            let bits = line.split("|")
            if bits.len() >= 2 && bits[0] != "" { names[bits[0]] = bits[1] }
        }
    }
    if fs.exists("syslang.txt") {
        let line = fs.read("syslang.txt").trim()
        for label in sys_labels {
            if label == line { sys_lang = line }
        }
    }
    refresh_lang_face()
    refresh_sys_face()
    ui.lang_menu.set_visible(false)
    ui.sys_menu.set_visible(false)
    ui.lang_custom.set_visible(lang_is_other)
    if lang_is_other { ui.custom_field.set_text(custom_lang) }
}
fn save_names(){
    let text = ""
    for a in accounts {
        let custom = names[a.id]
        if custom != nil && custom != "" {
            if text != "" { text = text + "\n" }
            text = text + a.id + "|" + custom
        }
    }
    fs.write("names.txt", text)
}
fn begin_rename(id){
    renaming = id
    rename_text = ""
    for a in accounts {
        if a.id == id { rename_text = display_name(a) }
    }
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn commit_rename(){
    if renaming == "" { return }
    finish_rename(renaming, rename_text)
}
fn finish_rename(id, text){
    names[id] = text.trim()
    renaming = ""
    rename_text = ""
    save_names()
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn is_open(id){
    if open_by[id] == nil { return true }
    return open_by[id]
}
fn folder_face(name, role){
    let n = ""
    if name != nil { n = ("" + name).trim() }
    let r = ""
    if role != nil { r = ("" + role).trim() }
    if r == "inbox" || n == "Inbox" || n == "INBOX" { return say("box_inbox") }
    if r == "flagged" || n == "Starred" || n == "Starred Mail" { return say("box_starred") }
    if r == "drafts" || n == "Drafts" || n == "Draft" { return say("box_drafts") }
    if r == "sent" || n == "Sent" || n == "Sent Mail" || n == "Sent Items" { return say("box_sent") }
    if r == "all" || n == "All Mail" || n == "All" { return say("box_all") }
    if r == "junk" || n == "Spam" || n == "Junk" || n == "Junk Mail" || n == "Junk E-mail" { return say("box_spam") }
    if r == "trash" || n == "Bin" || n == "Trash" || n == "Deleted" || n == "Deleted Items" || n == "Deleted Messages" { return say("box_bin") }
    if r == "important" || n == "Important" { return say("box_important") }
    if r == "archive" || n == "Archive" { return say("box_archive") }
    if n == "Notes" { return say("box_notes") }
    return n
}
fn drafts_box(name, role){
    return folder_face(name, role) == say("box_drafts")
}
fn show_heading(){
    ui.title.set_text(folder_face(folder.name, folder.role))
    if account == nil { ui.address.set_text("") }
    else { ui.address.set_text(account.address) }
}
fn load_accounts(){
    host.request("mail.accounts", {}, fn(r){
        if r.is_ok && r.data.len() > 0 {
            accounts = r.data
            let keep = false
            if account != nil {
                for a in accounts { if a.id == account.id { keep = true } }
            }
            if !keep {
                account = accounts[0]
                folder = {id: "INBOX" name: "Inbox" role: "inbox"}
            }
            pane("inbox")
            show_heading()
            ui.rail_slot.render()
            for a in accounts {
                if open_by[a.id] == nil { open_by[a.id] = true }
                load_folders(a.id)
            }
            list()
            if ui.settings_pane.visible() { ui.settings_accounts.render() }
        } else {
            accounts = []
            account = nil
            messages = []
            pane("welcome")
        }
    })
}
fn sys_slot(){
    let i = 0
    for label in sys_labels {
        if label == sys_lang { return i }
        i = i + 1
    }
    return 1
}
fn at5(i, en, zh, fr, ja, ru){
    if i == 0 { return en }
    if i == 2 { return fr }
    if i == 3 { return ja }
    if i == 4 { return ru }
    return zh
}
fn say(id){
    let i = sys_slot()
    if id == "password_missing" { return at5(i, "The account password is missing. Sign in again.", "这个邮箱的密码不在了，请重新登录。", "Le mot de passe du compte est absent. Reconnectez-vous.", "アカウントのパスワードがありません。もう一度ログインしてください。", "Пароль аккаунта отсутствует. Войдите снова.") }
    if id == "approval" { return at5(i, "Sending needs your approval in the host review.", "需要在宿主审阅里亲手批准后才会发送。", "L'envoi attend votre accord dans la revue de l'hôte.", "送信するにはホストの確認で自分で承認する必要があります。", "Отправка ждёт вашего подтверждения в окне проверки.") }
    if id == "revision" { return at5(i, "The draft changed. Keep the unsaved text and open the review again.", "草稿已经变化。请保留还没保存的文字，再重新打开审阅。", "Le brouillon a changé. Gardez le texte non enregistré et rouvrez la revue.", "下書きが変わりました。未保存の文を残して、確認を開き直してください。", "Черновик изменился. Сохраните несохранённый текст и откройте проверку снова.") }
    if id == "resource" { return at5(i, "The draft limit is full. Keep using an existing draft.", "草稿数量已满。请继续用已有草稿，不要为了重试再新建一封。", "La limite de brouillons est atteinte. Réutilisez un brouillon existant.", "下書きの上限です。新しい手紙を作らず、今の下書きを使ってください。", "Лимит черновиков исчерпан. Используйте уже существующий.") }
    if id == "cancelled" { return at5(i, "Review cancelled. Nothing was sent.", "已取消审阅，邮件没有发出。", "Revue annulée. Rien n'a été envoyé.", "確認を取り消しました。メールは送られていません。", "Проверка отменена. Письмо не отправлено.") }
    if id == "open_review" { return at5(i, "Open the app before reviewing this message.", "请先打开应用，再审阅这封邮件。", "Ouvrez l'application avant de relire ce message.", "このメールを確認する前にアプリを開いてください。", "Сначала откройте приложение, затем проверьте письмо.") }
    if id == "physical" { return at5(i, "This system cannot approve sending by hand.", "当前系统不能亲手批准发送。", "Ce système ne peut pas approuver l'envoi à la main.", "このシステムでは手動で送信を承認できません。", "Эта система не может подтвердить отправку вручную.") }
    if id == "no_review" { return at5(i, "This host has no mail review panel.", "这个宿主没有邮件审阅面板。", "Cet hôte n'a pas de panneau de revue du courrier.", "このホストにはメール確認パネルがありません。", "У этого узла нет панели проверки почты.") }
    if id == "no_message" { return at5(i, "That message could not be found.", "找不到这封邮件。", "Ce message est introuvable.", "そのメールが見つかりません。", "Это письмо не найдено.") }
    if id == "account_denied" { return at5(i, "This app cannot use that account.", "这个应用不能使用该邮箱账号。", "Cette application ne peut pas utiliser ce compte.", "このアプリはそのアカウントを使えません。", "Это приложение не может использовать этот аккаунт.") }
    if id == "one_recipient" { return at5(i, "Enter one recipient address.", "请填写一个收件人邮箱。", "Indiquez une seule adresse de destinataire.", "宛先は一つだけ入力してください。", "Укажите один адрес получателя.") }
    if id == "signin_cancel" { return at5(i, "Sign-in was cancelled.", "已取消登录。", "La connexion a été annulée.", "ログインを取り消しました。", "Вход отменён.") }
    if id == "signin_sheet" { return at5(i, "Sign in on the panel OctoSense shows.", "请在 OctoSense 弹出的面板上登录。", "Connectez-vous dans le panneau affiché par OctoSense.", "OctoSense が表示するパネルでログインしてください。", "Войдите в панели, которую показывает OctoSense.") }
    if id == "wrong_password" { return at5(i, "The password is wrong.", "密码不正确。", "Le mot de passe est incorrect.", "パスワードが違います。", "Неверный пароль.") }
    if id == "no_service" { return at5(i, "This device has no matching host service.", "这台设备上没有对应的宿主服务。", "Cet appareil n'a pas le service hôte correspondant.", "この端末には対応するホストサービスがありません。", "На этом устройстве нет нужной службы.") }
    if id == "composer" { return at5(i, "Only one recipient is allowed, and the body must be plain text.", "只能发给一个收件人，正文只能是纯文本。", "Un seul destinataire, et le texte doit être brut.", "宛先は一人だけで、本文はプレーンテキストだけです。", "Только один получатель, и текст без разметки.") }
    if id == "revision_required" { return at5(i, "The draft version does not match. Open the review again.", "草稿版本不匹配。请重新打开审阅，不要自动再发一次。", "La version du brouillon ne correspond pas. Rouvrez la revue.", "下書きの版が合いません。確認を開き直してください。", "Версия черновика не совпадает. Откройте проверку снова.") }
    if id == "submission" { return at5(i, "The send result is not certain yet. Check this draft before trying again.", "发送结果还不确定。请先查看这封草稿的状态，不要自动再发一次。", "Le résultat de l'envoi n'est pas certain. Vérifiez ce brouillon.", "送信結果がまだ分かりません。この下書きを確認してください。", "Результат отправки ещё не ясен. Сначала проверьте черновик.") }
    if id == "mail_queue_full" { return at5(i, "New mail cannot be refreshed yet. Update or restart OctoSense, then try again.", "暂时无法刷新新邮件。请更新或重新启动 OctoSense 后再试。", "Les nouveaux messages ne peuvent pas encore être actualisés. Mettez à jour ou redémarrez OctoSense, puis réessayez.", "新着メールを更新できません。OctoSense を更新または再起動してから、もう一度お試しください。", "Новые письма пока нельзя обновить. Обновите или перезапустите OctoSense и повторите попытку.") }
    if id == "sys_title" { return at5(i, "System language", "系统语言", "Langue du système", "システム言語", "Язык системы") }
    if id == "ui_hint" { return at5(i, "The interface uses this language.", "界面使用这个语言。", "L'interface utilise cette langue.", "画面はこの言語で表示されます。", "Интерфейс на этом языке.") }
    if id == "trans_title" { return at5(i, "Translation language", "翻译语言", "Langue de traduction", "翻訳言語", "Язык перевода") }
    if id == "trans_hint" { return at5(i, "Summarize and Translate use this language. If the mail is already in it, the text stays as it is.", "总结和翻译使用这个语言。如果邮件已经是这个语言，就保持原文。", "Résumer et Traduire utilisent cette langue. Si le message l'est déjà, le texte reste tel quel.", "要約と翻訳はこの言語を使います。メールがすでにその言語なら、原文のままです。", "Краткое содержание и перевод используют этот язык. Если письмо уже на нём, текст не меняется.") }
    if id == "settings" { return at5(i, "Settings", "设置", "Réglages", "設定", "Настройки") }
    if id == "accounts" { return at5(i, "Accounts", "账号", "Comptes", "アカウント", "Аккаунты") }
    if id == "system" { return at5(i, "System", "系统", "Système", "システム", "Система") }
    if id == "refresh" { return at5(i, "Refresh", "刷新", "Actualiser", "更新", "Обновить") }
    if id == "compose" { return at5(i, "Compose", "写信", "Écrire", "作成", "Написать") }
    if id == "back" { return at5(i, "‹ Back", "‹ 返回", "‹ Retour", "‹ 戻る", "‹ Назад") }
    if id == "translate" { return at5(i, "Translate", "翻译", "Traduire", "翻訳", "Перевести") }
    if id == "already_in" { return at5(i, "This mail is already in ", "这封邮件已经是", "Ce message est déjà en ", "このメールはすでに", "Это письмо уже на языке ") }
    if id == "already_tail" { return at5(i, ". The text was not replaced.", "，没有替换原文。", ". Le texte n'a pas été remplacé.", "なので、原文のままです。", ". Текст не заменён.") }
    if id == "showing_saved" { return at5(i, "Showing the saved translation in ", "正在显示已保存的译文，语言是", "Affichage de la traduction enregistrée en ", "保存済みの訳を表示しています。言語は", "Показан сохранённый перевод на языке ") }
    if id == "subject_is" { return at5(i, ". Subject: ", "。主题：", ". Objet : ", "。件名：", ". Тема: ") }
    if id == "no_trans_body" { return at5(i, "The translator returned no body.", "翻译没有返回正文。", "Le traducteur n'a pas renvoyé de texte.", "翻訳の本文がありません。", "Переводчик не вернул текст.") }
    if id == "translated_into" { return at5(i, "Translated into ", "已译成", "Traduit en ", "翻訳しました。言語は", "Переведено на ") }
    if id == "not_done" { return at5(i, "This request was not finished.", "这次请求没有完成。", "Cette demande n'a pas abouti.", "この依頼は完了しませんでした。", "Этот запрос не выполнен.") }
    if id == "translating" { return at5(i, "Translating…", "正在翻译…", "Traduction…", "翻訳中…", "Перевод…") }
    if id == "show_original" { return at5(i, "Show original", "显示原文", "Voir l'original", "原文を表示", "Показать оригинал") }
    if id == "recognize" { return at5(i, "AI Summary", "AI 总结", "Résumé IA", "AI 要約", "ИИ-итог") }
    if id == "todos" { return at5(i, "To-dos", "待办", "Tâches", "タスク", "Задачи") }
    if id == "todo_title" { return at5(i, "AgentMail To-dos", "AgentMail 待办", "Tâches AgentMail", "AgentMail タスク", "Задачи AgentMail") }
