    if id == "cancel" { return at5(i, "Cancel", "取消", "Annuler", "キャンセル", "Отмена") }
    if id == "draft" { return at5(i, "Help me write", "帮我写", "Écris pour moi", "書いて", "Напиши") }
    if id == "send" { return at5(i, "Send", "发送", "Envoyer", "送信", "Отправить") }
    if id == "to" { return at5(i, "To", "收件人", "Destinataire", "宛先", "Кому") }
    if id == "subject" { return at5(i, "Subject", "主题", "Objet", "件名", "Тема") }
    if id == "message" { return at5(i, "Message", "正文", "Message", "本文", "Текст") }
    if id == "add_account" { return at5(i, "Add account", "添加账号", "Ajouter un compte", "アカウントを追加", "Добавить аккаунт") }
    if id == "welcome" { return at5(i, "Add an account to read and send mail. OctoSense keeps your password; AgentMail never sees it.", "添加账号后即可收发邮件。密码由 OctoSense 保管，AgentMail 看不到。", "Ajoutez un compte pour lire et envoyer. OctoSense garde le mot de passe ; AgentMail ne le voit pas.", "アカウントを追加すると送受信できます。パスワードは OctoSense が保管し、AgentMail は見ません。", "Добавьте аккаунт, чтобы читать и отправлять почту. Пароль хранит OctoSense, AgentMail его не видит.") }
    if id == "no_mail" { return at5(i, "No mail yet.", "还没有邮件。", "Pas encore de courrier.", "メールはまだありません。", "Писем пока нет.") }
    if id == "loading" { return at5(i, "Loading…", "正在加载…", "Chargement…", "読み込み中…", "Загрузка…") }
    if id == "no_accounts" { return at5(i, "No accounts yet.", "还没有账号。", "Aucun compte.", "アカウントはまだありません。", "Аккаунтов пока нет.") }
    if id == "remove" { return at5(i, "Remove", "移除", "Retirer", "削除", "Удалить") }
    if id == "remove_ask" { return at5(i, "Remove this account?", "移除这个账号？", "Retirer ce compte ?", "このアカウントを削除しますか？", "Удалить этот аккаунт?") }
    if id == "api_body" { return at5(i, "AgentMail does not take an API key. Add your provider in OctoSense: Start → Settings → AI providers. The key stays on this device.", "AgentMail 不接收 API 密钥。请在 OctoSense 中添加：开始 → 设置 → AI providers。密钥只留在这台设备上。", "AgentMail ne demande pas de clé API. Ajoutez le fournisseur dans OctoSense : Démarrer → Réglages → AI providers. La clé reste sur cet appareil.", "AgentMail は API キーを受け取りません。OctoSense の 開始 → 設定 → AI providers で追加してください。キーはこの端末に残ります。", "AgentMail не принимает API-ключ. Добавьте провайдера в OctoSense: Пуск → Настройки → AI providers. Ключ остаётся на этом устройстве.") }
    if id == "test" { return at5(i, "Test connection", "测试连接", "Tester la connexion", "接続を試す", "Проверить соединение") }
    if id == "testing" { return at5(i, "Testing the connection…", "正在测试连接…", "Test de la connexion…", "接続を試しています…", "Проверка соединения…") }
    if id == "connected" { return at5(i, "Connected · using the model in AI providers", "已连接 · 使用 AI providers 里的模型", "Connecté · modèle défini dans AI providers", "接続済み · AI providers のモデルを使用", "Подключено · модель из AI providers") }
    if id == "agent" { return at5(i, "Agent", "助手", "Assistant", "アシスタント", "Ассистент") }
    if id == "ask_hint" { return at5(i, "Ask about the open message. Say all mail or a time period to use those instead.", "可以询问当前打开的邮件。也可以说全部邮件或一段时间。", "Posez une question sur le message ouvert, ou dites tout le courrier ou une période.", "開いているメールについて聞けます。すべてのメールや期間も指定できます。", "Спросите про открытое письмо, всю почту или период.") }
    if id == "ask" { return at5(i, "Ask", "提问", "Demander", "質問", "Спросить") }
    if id == "new_chat" { return at5(i, "New chat", "新对话", "Nouvelle discussion", "新しい会話", "Новый чат") }
    if id == "no_chats" { return at5(i, "No earlier chats yet.", "还没有更早的对话。", "Pas encore de discussion précédente.", "以前の会話はまだありません。", "Более ранних диалогов пока нет.") }
    if id == "delete_chat_ask" { return at5(i, "Delete this chat?", "删除这段对话？", "Supprimer cette discussion ?", "この会話を削除しますか？", "Удалить этот диалог?") }
    if id == "delete_chat_body" { return at5(i, "This chat history will be permanently deleted.", "这段聊天记录将被永久删除。", "Cet historique de discussion sera définitivement supprimé.", "このチャット履歴は完全に削除されます。", "История этого диалога будет удалена без возможности восстановления.") }
    if id == "delete_chat" { return at5(i, "Delete", "删除", "Supprimer", "削除", "Удалить") }
    if id == "draft_prompt" { return at5(i, "What should this say?", "这封信要写什么？", "Que doit dire ce message ?", "このメールには何を書きますか？", "Что написать в письме?") }
    if id == "let_ai" { return at5(i, "Let AI decide", "让 AI 决定", "Laisser l'IA décider", "AI に任せる", "Пусть решит ИИ") }
    if id == "lang_name" { return at5(i, "Language name", "语言名称", "Nom de la langue", "言語名", "Название языка") }
    if id == "name" { return at5(i, "Name", "名称", "Nom", "名前", "Имя") }
    if id == "box_inbox" { return at5(i, "Inbox", "收件箱", "Boîte de réception", "受信トレイ", "Входящие") }
    if id == "box_starred" { return at5(i, "Starred", "星标邮件", "Suivis", "スター付き", "Помеченные") }
    if id == "box_drafts" { return at5(i, "Drafts", "草稿箱", "Brouillons", "下書き", "Черновики") }
    if id == "box_sent" { return at5(i, "Sent", "已发送", "Envoyés", "送信済み", "Отправленные") }
    if id == "box_all" { return at5(i, "All Mail", "所有邮件", "Tous les messages", "すべてのメール", "Вся почта") }
    if id == "box_spam" { return at5(i, "Spam", "垃圾邮件", "Indésirables", "迷惑メール", "Спам") }
    if id == "box_bin" { return at5(i, "Bin", "废纸篓", "Corbeille", "ゴミ箱", "Корзина") }
    if id == "box_important" { return at5(i, "Important", "重要", "Important", "重要", "Важные") }
    if id == "box_archive" { return at5(i, "Archive", "归档", "Archives", "アーカイブ", "Архив") }
    if id == "box_notes" { return at5(i, "Notes", "笔记", "Notes", "メモ", "Заметки") }
    if id == "show_more" { return at5(i, "Show more", "查看更多", "Voir plus", "もっと見る", "Показать ещё") }
    if id == "checking" { return at5(i, "Checking for mail…", "正在检查邮件…", "Vérification du courrier…", "メールを確認しています…", "Проверка почты…") }
    if id == "one_new" { return at5(i, "1 new message", "1 封新邮件", "1 nouveau message", "新着 1 件", "1 новое письмо") }
    if id == "up_to_date" { return at5(i, "Up to date", "已是最新", "À jour", "最新です", "Всё актуально") }
    if id == "many_new" { return at5(i, " new messages", " 封新邮件", " nouveaux messages", " 件の新着", " новых писем") }
    if id == "classifying" { return at5(i, "Classifying the latest mail…", "正在分类最近的邮件…", "Classement des derniers messages…", "最近のメールを分類しています…", "Классификация последних писем…") }
    if id == "attachments" { return at5(i, "Attachments: ", "附件：", "Pièces jointes : ", "添付：", "Вложения: ") }
    if id == "saved_drafts" { return at5(i, "Saved to Drafts", "已存入草稿箱", "Enregistré dans Brouillons", "下書きに保存しました", "Сохранено в Черновики") }
    if id == "reviewing" { return at5(i, "The host is reviewing this message. Finish or cancel the review first.", "宿主正在审阅这封邮件，请先完成或取消审阅。", "L'hôte relit ce message. Terminez ou annulez d'abord.", "ホストが確認中です。先に完了するか取り消してください。", "Узел проверяет письмо. Сначала завершите или отмените проверку.") }
    if id == "leave_title" { return at5(i, "Leave the composer?", "要离开写信吗？", "Quitter la rédaction ?", "作成を離れますか？", "Выйти из письма?") }
    if id == "leave_body" { return at5(i, "Unsent text can be saved in this account's Drafts.", "未发送的内容可以存入这个邮箱原来的草稿箱。", "Le texte non envoyé peut aller dans les brouillons de ce compte.", "未送信の内容は、このアカウントの下書きに保存できます。", "Неотправленный текст можно сохранить в черновики этого аккаунта.") }
    if id == "dont_save" { return at5(i, "Don't save", "不保存", "Ne pas enregistrer", "保存しない", "Не сохранять") }
    if id == "save_drafts" { return at5(i, "Save to Drafts", "存入草稿箱", "Enregistrer", "下書きに保存", "В черновики") }
    if id == "confirm_again" { return at5(i, "Please confirm again", "请再确认一次", "Confirmez encore", "もう一度確認してください", "Подтвердите ещё раз") }
    if id == "confirm_body" { return at5(i, "Save into this account's Drafts?", "确认存入这个邮箱原来的草稿箱？", "Enregistrer dans les brouillons de ce compte ?", "このアカウントの下書きに保存しますか？", "Сохранить в черновики этого аккаунта?") }
    if id == "back_compose" { return at5(i, "Back to writing", "返回写信", "Retour à la rédaction", "作成に戻る", "Вернуться к письму") }
    if id == "confirm_save" { return at5(i, "Confirm save", "确认存入", "Confirmer", "保存する", "Подтвердить") }
    if id == "accepted" { return at5(i, "The host accepted this message.", "宿主已受理这封邮件。", "L'hôte a accepté ce message.", "ホストがこのメールを受け付けました。", "Узел принял это письмо.") }
    if id == "accepted_short" { return at5(i, "Message accepted", "邮件已受理", "Message accepté", "メールを受け付けました", "Письмо принято") }
    if id == "review_unsent" { return at5(i, "The review ended, but the message was not accepted. Checking this draft.", "审阅已结束，但邮件还没有被受理。正在核对这封草稿。", "La revue est finie, mais le message n'est pas accepté. Vérification du brouillon.", "確認は終わりましたが、まだ受け付けられていません。下書きを照合しています。", "Проверка закончилась, но письмо не принято. Сверяю черновик.") }
    if id == "checking_draft" { return at5(i, "Checking this draft…", "正在核对这封草稿…", "Vérification de ce brouillon…", "この下書きを照合しています…", "Сверяю этот черновик…") }
    if id == "opening_review" { return at5(i, "Opening the host review…", "正在打开宿主审阅…", "Ouverture de la revue…", "ホストの確認を開いています…", "Открываю проверку…") }
    if id == "draft_saved" { return at5(i, "Saved locally.", "已保存到本地。", "Enregistré sur cet appareil.", "この端末に保存しました。", "Сохранено на этом устройстве.") }
    if id == "draft_checked" { return at5(i, "Checked this draft. Status: ", "已核对这封草稿，状态：", "Brouillon vérifié. État : ", "下書きを照合しました。状態：", "Черновик сверен. Статус: ") }
    if id == "same_draft" { return at5(i, ". Still the same draft.", "。没有新开一封信。", ". Toujours le même brouillon.", "。新しいメールは作っていません。", ". Это тот же черновик.") }
    if id == "opened_draft" { return at5(i, "This message was saved in Drafts.", "这是草稿箱里保存的一封邮件。", "Ce message a été enregistré dans les brouillons.", "これは下書きに保存したメールです。", "Это письмо сохранено в черновиках.") }
    if id == "thinking" { return at5(i, "Thinking…", "正在思考…", "Réflexion…", "考えています…", "Думаю…") }
    if id == "open_first" { return at5(i, "Open a message first.", "请先打开一封邮件。", "Ouvrez d'abord un message.", "先にメールを開いてください。", "Сначала откройте письмо.") }
    if id == "still_working" { return at5(i, "Still working…", "还在处理…", "Encore en cours…", "まだ処理中です…", "Ещё работаю…") }
    if id == "need_account" { return at5(i, "Add an account first.", "请先添加账号。", "Ajoutez d'abord un compte.", "先にアカウントを追加してください。", "Сначала добавьте аккаунт.") }
    if id == "not_added" { return at5(i, "Not added to the schedule.", "没有加入日程。", "Pas ajouté à l'agenda.", "予定には追加しませんでした。", "В расписание не добавлено.") }
    if id == "no_pending" { return at5(i, "There is no schedule waiting.", "没有等待写入的日程。", "Aucun horaire en attente.", "書き込み待ちの予定はありません。", "Нет расписания для записи.") }
    if id == "added_cal" { return at5(i, "Added to the schedule.", "已加入日程。", "Ajouté à l'agenda.", "予定に追加しました。", "Добавлено в расписание.") }
    if id == "already_cal" { return at5(i, "This schedule is already saved.", "日程里已经有这一条。", "Cet horaire est déjà enregistré.", "この予定はすでにあります。", "Это расписание уже сохранено.") }
    if id == "os_saved" { return at5(i, "Saved on the system calendar.", "已写入系统日历。", "Enregistré dans le calendrier du système.", "システムのカレンダーに書き込みました。", "Записано в системный календарь.") }
    if id == "bad_time" { return at5(i, "Calendar could not understand that time. Nothing was added.", "日历无法识别这个时间，没有写入任何日程。", "Le calendrier ne comprend pas cette heure. Aucun événement n'a été ajouté.", "カレンダーが時刻を解釈できないため、予定は追加されませんでした。", "Календарь не распознал время. Событие не добавлено.") }
    if id == "no_calendar" { return at5(i, "No writable calendar was found.", "没有找到可写入的日历。", "Aucun calendrier modifiable.", "書き込めるカレンダーがありません。", "Нет календаря, доступного для записи.") }
    if id == "cal_denied" { return at5(i, "Calendar access was not granted.", "没有获得日历权限。", "L'accès au calendrier n'a pas été accordé.", "カレンダーの許可がありません。", "Доступ к календарю не дан.") }
    if id == "cal_unsupported" { return at5(i, "This system has no device calendar.", "这个系统没有设备日历。", "Ce système n'a pas de calendrier d'appareil.", "このシステムにはデバイスカレンダーがありません。", "На этой системе нет календаря устройства.") }
    if id == "cal_cancelled" { return at5(i, "Calendar review was cancelled. Nothing was added.", "已取消日历审阅，没有加入日程。", "Revue du calendrier annulée. Rien n'a été ajouté.", "カレンダー確認を取り消しました。予定は追加されていません。", "Проверка календаря отменена. Ничего не добавлено.") }
    if id == "cal_readonly" { return at5(i, "That calendar cannot be edited.", "这个日历不能修改。", "Ce calendrier ne peut pas être modifié.", "このカレンダーは編集できません。", "Этот календарь нельзя изменить.") }
    if id == "cal_unconfigured" { return at5(i, "This build cannot request calendar permission.", "这个版本不能申请日历权限。", "Cette version ne peut pas demander l'accès au calendrier.", "このビルドはカレンダー許可を申請できません。", "Эта сборка не может запросить доступ к календарю.") }
    if id == "cal_foreground" { return at5(i, "Open AgentMail, then approve the calendar review.", "请先打开 AgentMail，再同意日历审阅。", "Ouvrez AgentMail, puis approuvez la revue du calendrier.", "AgentMail を開いてから、カレンダーの確認に同意してください。", "Откройте AgentMail и подтвердите проверку календаря.") }
    if id == "readback" { return at5(i, "Read back: ", "读回确认：", "Relecture : ", "読み戻し：", "Прочитано: ") }
    if id == "readback_fail" { return at5(i, "Read-back failed. The schedule was not found.", "读回失败：写入后没有在日程记录里找到这一条。", "Relecture échouée : l'horaire n'a pas été retrouvé.", "読み戻し失敗：予定記録に見つかりません。", "Проверка не удалась: запись не найдена.") }
    if id == "calendar_add_failed" { return at5(i, "Calendar did not return a result for this write.", "日历写入没有返回结果，请重试。", "Le calendrier n'a renvoyé aucun résultat pour cet ajout.", "カレンダーへの書き込み結果が返されませんでした。", "Календарь не вернул результат записи.") }
    if id == "calendar_readback_failed" { return at5(i, "Calendar did not return a result for the read-back.", "日历读回没有返回结果；请在日历中核对这一条。", "Le calendrier n'a renvoyé aucun résultat de relecture.", "カレンダーの読み戻し結果が返されませんでした。", "Календарь не вернул результат проверки.") }
    if id == "security_high" { return at5(i, "Security warning: this message is likely phishing or fraud. Do not click links, download attachments, send money, or provide passwords or verification codes until you verify the sender through a trusted channel.", "安全警告：这封邮件很可能是钓鱼或诈骗邮件。在通过可信渠道核实发件人前，请勿点击链接、下载附件、付款，也不要提供密码或验证码。", "Alerte de sécurité : ce message est probablement une tentative d'hameçonnage ou de fraude. Ne cliquez sur aucun lien et ne transmettez aucune donnée sensible avant de vérifier l'expéditeur par un canal fiable.", "セキュリティ警告：このメールはフィッシングまたは詐欺の可能性が高いです。信頼できる方法で送信者を確認するまで、リンク、添付、支払い、パスワードや認証コードの入力を避けてください。", "Предупреждение безопасности: письмо похоже на фишинг или мошенничество. Не открывайте ссылки и вложения, не переводите деньги и не сообщайте пароли или коды, пока не проверите отправителя по надёжному каналу.") }
    if id == "security_caution" { return at5(i, "Caution: this message contains suspicious signals. Verify the sender and destination domain before taking action.", "注意：这封邮件包含可疑信号。采取操作前，请先核实发件人以及链接实际指向的域名。", "Attention : ce message contient des signaux suspects. Vérifiez l'expéditeur et le domaine de destination avant d'agir.", "注意：このメールには不審な兆候があります。操作する前に送信者とリンク先ドメインを確認してください。", "Осторожно: в письме есть подозрительные признаки. Перед действием проверьте отправителя и домен ссылки.") }
    if id == "security_clear" { return at5(i, "Security check: no clear phishing signal was found. This is not a guarantee; keep checking unexpected requests.", "安全检查：未发现明确的钓鱼信号。这并非安全保证，遇到意外请求仍请自行核实。", "Contrôle de sécurité : aucun signe clair d'hameçonnage. Ce n'est pas une garantie ; vérifiez toute demande inattendue.", "セキュリティ確認：明確なフィッシング兆候は見つかりませんでした。安全を保証するものではないため、予期しない依頼は確認してください。", "Проверка безопасности: явных признаков фишинга не найдено. Это не гарантия; проверяйте неожиданные запросы.") }
    if id == "security_evidence" { return at5(i, "Why: ", "判断依据：", "Raisons : ", "判断理由：", "Причины: ") }
    if id == "security_links" { return at5(i, "Suspicious links: ", "可疑链接：", "Liens suspects : ", "不審なリンク：", "Подозрительные ссылки: ") }
    if id == "class_ok" { return at5(i, "Read back: ", "读回确认：", "Relecture : ", "読み戻し：", "Прочитано: ") }
    if id == "class_match" { return at5(i, " classifications match the record", " 条分类与记录一致", " classements correspondent", " 件の分類が記録と一致", " классификаций совпали") }
    if id == "class_miss" { return at5(i, " did not match", " 条没有对上", " ne correspondent pas", " 件が一致しません", " не совпали") }
    if id == "budget" { return at5(i, "Today's model allowance is used up.", "今天的模型额度已经用完。", "Le quota du modèle pour aujourd'hui est épuisé.", "今日のモデル利用枠を使い切りました。", "Дневной лимит модели исчерпан.") }
    if id == "rate" { return at5(i, "Too many model calls. Wait a moment.", "模型调用太频繁，请稍等。", "Trop d'appels au modèle. Patientez.", "モデルの呼び出しが多すぎます。少し待ってください。", "Слишком много вызовов модели. Подождите.") }
    if id == "no_provider" { return at5(i, "No AI provider is set up.", "还没有设置 AI 提供方。", "Aucun fournisseur d'IA n'est configuré.", "AI プロバイダが未設定です。", "Поставщик ИИ не настроен.") }
    if id == "provider_down" { return at5(i, "The AI provider did not answer.", "AI 提供方没有回应。", "Le fournisseur d'IA n'a pas répondu.", "AI プロバイダから応答がありません。", "Поставщик ИИ не ответил.") }
    if id == "bad_answer" { return at5(i, "The model's answer could not be used.", "模型的回答无法使用。", "La réponse du modèle est inutilisable.", "モデルの回答を使えません。", "Ответ модели нельзя использовать.") }
    return at5(i, "Something went wrong.", "出现未知错误。", "Une erreur inconnue s'est produite.", "不明なエラーが起きました。", "Произошла неизвестная ошибка.")
}
fn local_error(raw){
    let t = ""
    if raw != nil { t = "" + raw }
    if t == "" { return say("unknown") }
    if t.search("password is missing") >= 0 { return say("password_missing") }
    if t.search("approval_required") >= 0 { return say("approval") }
    if t.search("revision_conflict") >= 0 { return say("revision") }
    if t.search("resource_limit") >= 0 { return say("resource") }
    if t.search("Review cancelled") >= 0 { return say("cancelled") }
    if t.search("Open the app to review") >= 0 || t.search("Open Mail to review") >= 0 { return say("open_review") }
    if t.search("Physical Mail send") >= 0 { return say("physical") }
    if t.search("no native Mail review") >= 0 { return say("no_review") }
    if t.search("There is no such message") >= 0 { return say("no_message") }
    if t.search("may not use that account") >= 0 { return say("account_denied") }
    if t.search("Enter one recipient") >= 0 { return say("one_recipient") }
    if t.search("Sign-in cancelled") >= 0 { return say("signin_cancel") }
    if t.search("Signing in needs") >= 0 { return say("signin_sheet") }
    if t.search("Wrong password") >= 0 { return say("wrong_password") }
    if t.search("no service answers") >= 0 { return say("no_service") }
    if t.search("Unsupported composer") >= 0 { return say("composer") }
    if t.search("expected_revision") >= 0 { return say("revision_required") }
    if t.search("Submission status") >= 0 { return say("submission") }
    if t.search("Incoming mail queue is full") >= 0 { return say("mail_queue_full") }
    if t.search("authorization_required") >= 0 { return say("cal_denied") }
    if t.search("unsupported_platform") >= 0 { return say("cal_unsupported") }
    if t.search("Calendar review closed") >= 0 || t.search("trusted_input_required") >= 0 { return say("cal_cancelled") }
    if t.search("read_only") >= 0 { return say("cal_readonly") }
    if t.search("host_not_configured") >= 0 { return say("cal_unconfigured") }
    if t.search("foreground_required") >= 0 { return say("cal_foreground") }
    if t.search("invalid_handle") >= 0 || t.search("calendar_changed") >= 0 { return say("no_calendar") }
    if t.search("Invalid start_ms") >= 0 || t.search("Invalid end_ms") >= 0 || t.search("Time window") >= 0 || t.search("timezone") >= 0 || t.search("is not a time") >= 0 || t.search("event ends before") >= 0 { return say("bad_time") }
    if t.search("tokens for today") >= 0 || t.search("model calls for today") >= 0 { return say("budget") }
    if t.search("model calls a minute") >= 0 { return say("rate") }
    if t.search("No AI provider is set up") >= 0 || t.search("could not be read") >= 0 { return say("no_provider") }
    if t.search("No AI provider answered") >= 0 { return say("provider_down") }
    if t.search("answer was refused") >= 0 { return say("bad_answer") }
    return say("unknown") + "\n" + t
}
fn add_account(){
    status(say("signin_sheet"))
    ui.welcome_note.set_text(say("signin_sheet"))
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { load_accounts() }
        else {
            status(local_error(r.error))
            ui.welcome_note.set_text(local_error(r.error))
        }
    })
}
fn toggle_account(id){
    open_by[id] = !is_open(id)
    ui.rail_slot.render()
}
fn load_folders(id){
    host.request("mail.folders", {account: id}, fn(r){
        if r.is_ok {
            folders_by[id] = r.data
            ui.rail_slot.render()
            queue_account(id)
        }
    })
}
fn queued(aid, fid){
    for item in sync_queue {
        if item.account == aid && item.folder == fid { return true }
    }
    return false
}
fn enqueue_sync(aid, fid){
    if aid == "" || fid == "" { return }
    if queued(aid, fid) { return }
    sync_queue.push({account: aid folder: fid})
}
fn queue_account(id){
    enqueue_sync(id, "INBOX")
    let found = folders_by[id]
    if found != nil {
        for f in found {
            let fid = "" + f.id
            if fid != "INBOX" { enqueue_sync(id, fid) }
        }
    }
    pump_sync()
}
fn select_named_now(aid, fid, fname){
    for a in accounts {
        if a.id == aid { account = a }
    }
    let role = ""
    let known = folders_by[aid]
    if known != nil {
        for item in known {
            if item.id == fid && item.role != nil { role = item.role }
        }
    }
    folder = {id: fid name: fname role: role}
    list_shown = 25
    list_total = 0
    list_loaded = 0
    messages = []
    if drafts_box(fname, role) { messages = saved_draft_rows() }
    close_detail()
    show_heading()
    ui.rail_slot.render()
    paint_rows()
    list()
}
fn select_named(aid, fid, fname){
    if ui.composer.visible() {
        request_leave("folder", aid, fid, fname)
        return
    }
    select_named_now(aid, fid, fname)
}
fn select_folder(a, f){
    select_named(a.id, f.id, f.name)
}
fn pump_sync(){
    if busy { return }
    if sync_queue.len() == 0 { return }
    let job = sync_queue[0]
    let rest = []
    let i = 0
    for item in sync_queue {
        if i > 0 { rest.push(item) }
        i = i + 1
    }
    sync_queue = rest
    busy = true
    let sync_account = job.account
    let syncing = job.folder
    if account != nil && account.id == sync_account && ("" + folder.id) == syncing { status(say("checking")) }
    host.request("mail.sync", {account: sync_account folder: syncing}, fn(r){
        busy = false
        let still = account != nil && account.id == sync_account && ("" + folder.id) == syncing
        if r.is_ok {
            if still {
                if r.data.new == 1 { status(say("one_new")) }
                else if r.data.new > 0 { status("" + r.data.new + say("many_new")) }
                else { status(say("up_to_date")) }
                list()
            }
        } else if still { status(local_error(r.error)) }
        if sync_again && account != nil {
            sync_again = false
            let again = "" + folder.id
            let rest2 = [{account: account.id folder: again}]
            for item in sync_queue { rest2.push(item) }
            sync_queue = rest2
        }
        pump_sync()
    })
}
fn sync(){
    if account == nil { return }
    if busy { sync_again = true; return }
    let fid = "" + folder.id
    let rest = [{account: account.id folder: fid}]
    for item in sync_queue {
        if item.account != account.id || item.folder != fid { rest.push(item) }
    }
    sync_queue = rest
    pump_sync()
}
fn load_classes(){
    classes = {}
    if !fs.exists("classes.txt") { return }
    let lines = fs.read("classes.txt").split("\n")
    for line in lines {
        let bits = line.split("|")
        if bits.len() >= 2 && bits[0] != "" { classes[bits[0]] = bits[1] }
    }
}
fn save_classes(){
    let text = ""
    for m in recent {
        let c = classes[m.id]
        if c != nil && c != "" {
            if text != "" { text = text + "\n" }
            text = text + m.id + "|" + c
        }
    }
    fs.write("classes.txt", text)
}
fn folder_names(){
    if account == nil { return "" }
    let found = folders_by[account.id]
    if found == nil { return "" }
    let t = ""
    for f in found {
        if t != "" { t = t + ", " }
        t = t + f.name
    }
    return t
}
fn name_ok(name){
    if account == nil { return false }
    let found = folders_by[account.id]
    if found == nil { return false }
    for f in found { if f.name == name { return true } }
    return false
}
fn paint_rows(){
    total = messages.len()
    show_heading()
    if messages.len() == 0 {
        ui.rows.set_visible(false)
        ui.rows_empty.set_visible(true)
    } else {
        ui.rows_empty.set_visible(false)
        ui.rows.set_visible(true)
        ui.rows.render()
    }
    let count = list_total
    if count < messages.len() { count = messages.len() }
    status(folder_face(folder.name, folder.role) + " · " + count)
}
fn show_current(raw){
    messages = raw
    paint_rows()
}
fn classify_some(){
    if classifying || account == nil { return }
    if folder_names() == "" { return }
    let pending = []
    let i = 0
    for m in recent {
        if i < classify_goal {
            if classes[m.id] == nil || classes[m.id] == "" { pending.push(m) }
        }
        i = i + 1
    }
    if pending.len() == 0 { return }
    let n = pending.len()
    if n > 20 { n = 20 }
    let batch = ""
    for i in n {
        let m = pending[i]
        batch = batch + m.id + " | " + m.sender + " | " + m.subject + "\n"
    }
    let allowed = folder_names()
    classifying = true
    status(say("classifying"))
    host.request("model.complete", {
        task: "Classify each email into one existing mailbox folder. For every line, reply with one line id|Folder. Folder must be copied exactly from the allowed list. Do not invent a folder name. Return every id. No other text."
        input: {allowed: allowed mail: batch}
        schema: answer_schema()
        class: "fast"
    }, fn(r){
        classifying = false
        let got = 0
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.answer != nil {
            let lines = r.data.output.answer.split("\n")
            for line in lines {
                let bits = line.split("|")
                if bits.len() >= 2 && name_ok(bits[1].trim()) {
                    classes[bits[0].trim()] = bits[1].trim()
                    got = got + 1
                }
            }
            if got > 0 {
                save_classes()
                let expect = []
                for line in lines {
                    let bits = line.split("|")
                    if bits.len() >= 2 && name_ok(bits[1].trim()) {
                        expect.push({id: bits[0].trim() folder: bits[1].trim()})
                    }
                }
                load_classes()
                let matched = 0
                let miss = 0
                for item in expect {
                    if classes[item.id] == item.folder { matched = matched + 1 }
                    else { miss = miss + 1 }
                }
                let note = say("class_ok") + matched + say("class_match")
                if miss > 0 { note = note + "，" + miss + say("class_miss") }
                show_current(messages)
                status(note)
            } else {
                show_current(messages)
            }
        } else {
            show_current(messages)
            if !r.is_ok { status(local_error(r.error)) }
        }
        if got > 0 { classify_some() }
    })
}
fn mailbox_drafts(){
    if account == nil { return nil }
    let found = folders_by[account.id]
    if found == nil { return nil }
    for item in found {
        if item.role == "drafts" { return item }
    }
    return nil
}
fn saved_draft_rows(){
    load_local_drafts()
    let rows = []
    if account == nil { return rows }
    let aid = "" + account.id
    let only = accounts.len() <= 1
    for d in local_drafts {
        let mine = ""
        if d.account != nil { mine = "" + d.account }
        if mine == aid || only {
            let sub = d.subject
            if sub == nil || sub == "" { sub = "（无主题）" }
            let who = d.to
            if who == nil || who == "" { who = "未填写收件人" }
            rows.push({id: d.id sender: who time: "草稿" subject: sub preview: clip(d.body, 90) unread: false})
        }
    }
    return rows
}
fn list(){
    if account == nil { return }
    list_token = list_token + 1
    list_acc = []
    let token = list_token
    let wanted = "" + folder.id
    let wanted_name = "" + folder.name
    let wanted_role = ""
    if folder.role != nil { wanted_role = "" + folder.role }
    load_list_page(token, wanted, wanted_name, wanted_role, 0)
}
fn load_list_page(token, wanted, wanted_name, wanted_role, offset){
    host.request("mail.list", {account: account.id folder: wanted offset: offset limit: 25}, fn(r){
        if token != list_token { return }
        if ("" + folder.id) != wanted { return }
        if !r.is_ok {
            if drafts_box(wanted_name, wanted_role) {
                let kept = saved_draft_rows()
                if kept.len() > 0 { show_current(kept); return }
            }
            status(local_error(r.error))
            return
        }
        if r.data != nil && r.data.folder != nil && ("" + r.data.folder) != wanted { return }
        let raw = []
        if r.data != nil && r.data.messages != nil { raw = r.data.messages }
        for m in raw { list_acc.push(m) }
        let total = list_acc.len()
        if r.data != nil && r.data.total != nil { total = r.data.total }
        list_total = total
        if raw.len() > 0 && list_acc.len() < list_shown && list_acc.len() < total {
            load_list_page(token, wanted, wanted_name, wanted_role, list_acc.len())
            return
        }
        list_loaded = list_acc.len()
        let shown = []
        for m in list_acc { shown.push(m) }
        if wanted == "INBOX" || wanted_name == "Inbox" { recent = shown }
        if drafts_box(wanted_name, wanted_role) {
            let merged = saved_draft_rows()
            for m in shown { merged.push(m) }
            shown = merged
        }
        show_current(shown)
    })
}
fn show_more(){
    list_shown = list_shown + 25
    list()
}
fn is_saved_draft(id){
    if id == "" { return false }
    for d in local_drafts {
        if d.id == id { return true }
    }
    return false
}
fn open_message(m){
    let mid = ""
    if m.id != nil { mid = "" + m.id }
    if is_saved_draft(mid) { open_saved_draft(mid); return }
    open_id = m.id
    host.request("mail.message", {account: account.id folder: folder.id message: m.id}, fn(r){
        if r.is_ok {
            reading = r.data
            ui.r_subject.set_text(r.data.subject)
            ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
            ui.r_time.set_text(r.data.time)
            // Formatted mail shows as the host rebuilt it: text, links and
            // lists, nothing remote.
            let formatted = r.data.html != ""
            ui.r_html.set_visible(formatted)
            ui.r_body.set_visible(!formatted)
            if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_body.set_text(r.data.body) }
            let names = ""
            for a in r.data.attachments {
                if names != "" { names = names + ", " }
                names = names + a.filename + " (" + kb(a.size) + ")"
            }
            ui.r_attachments.set_visible(names != "")
            ui.r_attachments.set_text(say("attachments") + names)
            show_reader()
            m.unread = false
            host.request("mail.mark_read", {account: account.id folder: folder.id message: m.id}, fn(done){
                if !done.is_ok { status(local_error(done.error)) }
            })
        } else { status(local_error(r.error)) }
    })
}
fn compose(to, subject, body){
    compose_id = ""
    compose_revision = 0
    editing_draft = ""
    save_noted = false
    quiet_notes = false
    compose_generation = compose_generation + 1
    preparing_review = false
    reply_message = ""
    reply_folder = ""
    if compose_kind == "reply" && open_id != "" {
        reply_message = open_id
        if folder.id != "drafts" { reply_folder = folder.id }
    }
    ui.c_to.set_text(to)
    ui.c_subject.set_text(subject)
    ui.c_body.set_text(body)
    ui.c_note.set_text("")
    show_composer()
    touch_draft()
}
fn reply(){
    if reading == nil { return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    compose_kind = "reply"
    compose(reading.address, subject, "")
}
fn draft_status_zh(st){
    let i = sys_slot()
    if st == "draft" { return at5(i, "draft", "草稿", "brouillon", "下書き", "черновик") }
    if st == "awaiting_approval" { return at5(i, "waiting for approval", "等待批准", "en attente d'accord", "承認待ち", "ожидает подтверждения") }
    if st == "sending" { return at5(i, "sending", "正在发送", "envoi", "送信中", "отправка") }
    if st == "accepted" { return at5(i, "accepted", "已受理", "accepté", "受付済み", "принято") }
    if st == "outcome_unknown" { return at5(i, "result unknown", "结果不确定", "résultat inconnu", "結果不明", "результат неизвестен") }
    if st == "failed_before_delivery" { return at5(i, "failed before sending", "发送前失败", "échec avant l'envoi", "送信前に失敗", "сбой до отправки") }
    if st == "cancelled" { return at5(i, "cancelled", "已取消", "annulé", "取消", "отменено") }
    if st == nil || st == "" { return at5(i, "unknown", "未知", "inconnu", "不明", "неизвестно") }
    return "" + st
}
fn source_folder(){
    if reply_folder != "" { return reply_folder }
    if folder.id == "" || folder.id == "drafts" { return "INBOX" }
    return folder.id
}
fn email_ok(text){
    let t = text.trim()
    if t.search("@") < 1 { return false }
    if t.search(" ") >= 0 { return false }
    if t.search(",") >= 0 { return false }
    if t.search(";") >= 0 { return false }
    return true
}
fn composer_dirty(){
    if !ui.composer.visible() { return false }
    if ui.c_to.text().trim() != "" { return true }
    if ui.c_subject.text().trim() != "" { return true }
    if ui.c_body.text().trim() != "" { return true }
    return false
}
fn remember_compose(r){
    if !r.is_ok || r.data == nil { return false }
    if r.data.compose_id != nil && r.data.compose_id != "" { compose_id = r.data.compose_id }
    if r.data.revision != nil { compose_revision = r.data.revision }
    return true
}
fn refresh_compose_status(){
    if account == nil || compose_id == "" {
        send_after_status = false
        retry_save = false
        return
    }
    let generation = compose_generation
    host.request("mail.compose_status", {account: account.id compose_id: compose_id}, fn(r){
        if generation != compose_generation { return }
        if remember_compose(r) {
            let st = ""
            if r.data.status != nil { st = "" + r.data.status }
            if !quiet_notes { ui.c_note.set_text(say("draft_checked") + draft_status_zh(st) + say("same_draft")) }
            if retry_save {
                retry_save = false
                save_host_draft()
            }
            if send_after_status {
                send_after_status = false
                send()
            }
            return
        }
        send_after_status = false
        retry_save = false
        if !quiet_notes { ui.c_note.set_text(local_error(r.error)) }
    })
}
fn host_draft_settled(r){
    draft_saving = false
    if save_generation != compose_generation { return }
    if remember_compose(r) {
        if !quiet_notes { note_saved() }
        if retry_save {
            retry_save = false
            save_host_draft()
        }
        return
    }
    let err = ""
    if r.error != nil { err = "" + r.error }
    if err.search("revision_conflict") >= 0 || err.search("expected_revision") >= 0 {
        retry_save = true
        refresh_compose_status()
    }
}
fn save_host_draft(){
    if account == nil || preparing_review || !ui.composer.visible() { return }
    let to = ui.c_to.text().trim()
    if !email_ok(to) { return }
    if draft_saving {
        retry_save = true
        return
    }
    if compose_id != "" && !(compose_revision > 0) {
        retry_save = true
        refresh_compose_status()
        return
    }
    draft_saving = true
    save_generation = compose_generation
    let subject = ui.c_subject.text()
    let body = ui.c_body.text()
    let src = source_folder()
    if compose_id == "" {
        host.request("mail.compose", {account: account.id to: to subject: subject body: body folder: src message: reply_message}, fn(r){ host_draft_settled(r) })
    } else {
        host.request("mail.compose", {account: account.id compose_id: compose_id expected_revision: compose_revision to: to subject: subject body: body folder: src message: reply_message}, fn(r){ host_draft_settled(r) })
    }
}
fn touch_draft(){
    draft_save_gen = draft_save_gen + 1
    let token = draft_save_gen
    start_timeout(0.6, || {
        if token != draft_save_gen { return }
        save_host_draft()
    })
}
fn load_local_drafts(){
    if !fs.exists("drafts.txt") { return }
    let parsed = []
    let lines = fs.read("drafts.txt").split("\n")
    for line in lines {
        if line == "" { continue }
        let bits = line.split("|")
        if bits.len() >= 6 {
            let msg = ""
            let src = ""
            if bits.len() >= 7 { msg = unpack(bits[6]) }
            if bits.len() >= 8 { src = unpack(bits[7]) }
            parsed.push({id: unpack(bits[0]) account: unpack(bits[1]) to: unpack(bits[2]) subject: unpack(bits[3]) body: unpack(bits[4]) compose_id: unpack(bits[5]) message: msg folder: src category: "Drafts"})
        }
    }
    local_drafts = parsed
}
fn save_local_drafts(){
    let text = ""
    for d in local_drafts {
        if text != "" { text = text + "\n" }
        let msg = ""
        let src = ""
        if d.message != nil { msg = d.message }
        if d.folder != nil { src = d.folder }
        text = text + pack(d.id) + "|" + pack(d.account) + "|" + pack(d.to) + "|" + pack(d.subject) + "|" + pack(d.body) + "|" + pack(d.compose_id) + "|" + pack(msg) + "|" + pack(src)
    }
    fs.write("drafts.txt", text)
}
fn store_local_draft(){
    if account == nil { return }
    let id = editing_draft
    if id == "" || ("" + id).search("local-") != 0 {
        id = "local-" + compose_generation + "-" + local_drafts.len()
    }
    let msg = reply_message
    let src = source_folder()
    let row = {id: id account: account.id to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text() compose_id: compose_id message: msg folder: src category: "Drafts"}
    let next = []
    let placed = false
    for d in local_drafts {
        let same = false
        if d.id == id { same = true }
        if editing_draft != "" && d.id == editing_draft { same = true }
        if compose_id != "" && d.compose_id == compose_id { same = true }
        if same {
            if !placed { next.push(row); placed = true }
        } else { next.push(d) }
    }
    if !placed { next.push(row) }
    let fresh = !placed
    local_drafts = next
    editing_draft = id
    save_local_drafts()
    if fresh {
        status(say("saved_drafts"))
        note_saved()
    }
    save_host_draft()
}
fn drop_saved_draft(){
    let next = []
    for d in local_drafts {
        let drop = false
        if editing_draft != "" && d.id == editing_draft { drop = true }
        if compose_id != "" && d.compose_id == compose_id { drop = true }
        if !drop { next.push(d) }
    }
    local_drafts = next
    save_local_drafts()
    editing_draft = ""
}
fn open_saved_draft(id){
    for d in local_drafts {
        if d.id != id { continue }
        compose_kind = "new"
        reply_message = ""
        reply_folder = ""
        open_id = ""
        if d.message != nil && d.message != "" {
            compose_kind = "reply"
            reply_message = d.message
            open_id = d.message
            if d.folder != nil { reply_folder = d.folder }
        }
        compose_id = ""
        if d.compose_id != nil { compose_id = d.compose_id }
        compose_revision = 0
        editing_draft = d.id
        save_noted = true
        quiet_notes = true
        compose_generation = compose_generation + 1
        preparing_review = false
        ui.c_to.set_text(d.to)
        ui.c_subject.set_text(d.subject)
        ui.c_body.set_text(d.body)
        ui.c_note.set_text("")
        show_composer()
        if compose_id != "" { refresh_compose_status() }
        return
    }
}
fn perform_leave(kind, aid, fid, fname){
    if kind == "folder" { select_named_now(aid, fid, fname); return }
    if kind == "settings" {
        close_detail()
        show_settings()
        return
    }
    close_detail()
    ui.rows.render()
}
fn request_leave(kind, aid, fid, fname){
    if preparing_review {
        ui.c_note.set_text(say("reviewing"))
        return
    }
    if editing_draft != "" && is_saved_draft(editing_draft) {
        store_local_draft()
        perform_leave(kind, aid, fid, fname)
        list()
        return
    }
    if !composer_dirty() {
        perform_leave(kind, aid, fid, fname)
        return
    }
    leave_kind = kind
    leave_aid = aid
    leave_fid = fid
    leave_fname = fname
    leave_step = 1
    ui.draft_title.set_text(say("leave_title"))
    ui.draft_body.set_text(say("leave_body"))
    ui.draft_no_label.set_text(say("dont_save"))
    ui.draft_yes_label.set_text(say("save_drafts"))
    ui.draft_ask.set_visible(true)
}
fn draft_no(){
    ui.draft_ask.set_visible(false)
    leave_step = 0
    perform_leave(leave_kind, leave_aid, leave_fid, leave_fname)
}
fn note_saved(){
    if quiet_notes || save_noted { return }
    save_noted = true
    show_note(say("draft_saved"))
}
fn show_note(text){
    note_token = note_token + 1
    let token = note_token
    ui.c_note.set_text(text)
    start_timeout(2, || {
        if token != note_token { return }
        ui.c_note.set_text("")
    })
}
fn draft_yes(){
    ui.draft_ask.set_visible(false)
    leave_step = 0
    store_local_draft()
    if leave_kind == "inbox" {
        let box = mailbox_drafts()
        if box != nil && account != nil {
            select_named_now(account.id, box.id, box.name)
            return
        }
    }
    perform_leave(leave_kind, leave_aid, leave_fid, leave_fname)
}
fn send_settled(generation, r){
    if generation != compose_generation { return }
    preparing_review = false
    remember_compose(r)
    if r.is_ok && r.data != nil && r.data.accepted == true {
        ui.c_note.set_text(say("accepted"))
        status(say("accepted_short"))
        drop_saved_draft()
        close_detail()
        ui.rows.render()
        return
    }
    if r.is_ok {
        ui.c_note.set_text(say("review_unsent"))
        refresh_compose_status()
        return
    }
    let err = ""
    if r.error != nil { err = "" + r.error }
    ui.c_note.set_text(local_error(r.error))
    if compose_id != "" || err.search("revision_conflict") >= 0 || err.search("Submission status") >= 0 || err.search("outcome") >= 0 {
        refresh_compose_status()
    }
}
fn send(){
    if account == nil || preparing_review { return }
    if compose_id != "" && !(compose_revision > 0) {
        send_after_status = true
        ui.c_note.set_text(say("checking_draft"))
        refresh_compose_status()
        return
    }
    preparing_review = true
    draft_save_gen = draft_save_gen + 1
    let generation = compose_generation
    ui.c_note.set_text(say("opening_review"))
    let to = ui.c_to.text()
    let subject = ui.c_subject.text()
    let body = ui.c_body.text()
    let src = source_folder()
    if compose_id == "" {
        host.request("mail.review_send", {account: account.id to: to subject: subject body: body folder: src message: reply_message}, fn(r){
            send_settled(generation, r)
        })
    } else {
        host.request("mail.review_send", {account: account.id compose_id: compose_id expected_revision: compose_revision to: to subject: subject body: body folder: src message: reply_message}, fn(r){
            send_settled(generation, r)
        })
    }
}
fn remove_account(id){
    if id == "" { return }
    host.request("mail.remove_account", {account: id}, fn(r){
        if r.is_ok { load_accounts() } else { status(local_error(r.error)) }
    })
}
fn ask_remove(a){
    commit_rename()
    pending_remove = a.id
    ui.confirm_name.set_text(display_name(a))
    ui.confirm.set_visible(true)
}
fn cancel_remove(){
    pending_remove = ""
    ui.confirm.set_visible(false)
}
fn confirm_remove(){
