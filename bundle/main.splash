let accounts = []
let account = nil          // {id, address}
let messages = []
let total = 0
let open_id = ""
let reading = nil
let busy = false
let folder = {id: "INBOX" name: "Inbox"}
let recent = []
let classes = {}
let classify_goal = 100
let classifying = false
let folders_by = {}
let open_by = {}
let names = {}
let renaming = ""
let rename_text = ""
let rail_open = true
let agent_open = false
let agent_busy = false
let settings_tab = "account"
let pending_remove = ""
let chat_log = []
let pending_q = ""
let pending_input = ""
let pending_event = nil
let saved_events = []
let turn_can_add = false
let follow_gen = 0
let follow_locked = false
let chat_follow = true
let history_open = false
let sessions = []
let active_session = -1
let compose_kind = "new"
let arg_to = ""
let arg_subject = ""
let arg_body = ""
let arg_query = ""
let arg_since = ""
let arg_until = ""
let arg_span = ""
let in_chain = false
let react_step = 0
let react_trace = ""
let chain_names = []
let chain_i = 0
let chain_log = ""
let target_lang = "中文"
let lang_open = false
let lang_is_other = false
let custom_lang = ""
let lang_labels = ["English" "中文" "Español" "Français" "Deutsch" "日本語" "한국어" "Português" "Italiano" "Русский" "العربية" "हिन्दी" "Türkçe" "Tiếng Việt" "Bahasa Indonesia" "ไทย" "Nederlands" "Polski" "Other"]
let trans_busy = false
let view_trans = {}
let saved_sum = {}
let saved_trans = {}
let saved_subject = {}
let saved_trans_lang = {}
let sum_keys = []
let trans_keys = []

fn status(text){ ui.status.set_text(text) }
fn pane(name){
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
}
fn show_reader(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(true)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
    paint_mail()
}
fn show_composer(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(true)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
}
fn close_detail(){
    commit_rename()
    reading = nil
    open_id = ""
    pending_remove = ""
    ui.list_pane.set_visible(true)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
}
fn toggle_rail(){
    rail_open = !rail_open
    ui.rail_slot.render()
}
fn local_part(address){
    if address == nil { return "" }
    let bits = address.split("@")
    if bits.len() > 0 && bits[0] != "" { return bits[0] }
    return address
}
fn display_name(a){
    let custom = names[a.id]
    if custom != nil && custom != "" { return custom }
    return local_part(a.address)
}
fn load_prefs(){
    load_chats()
    load_tools()
    load_classes()
    load_events()
    if fs.exists("names.txt") {
        let lines = fs.read("names.txt").split("\n")
        for line in lines {
            let bits = line.split("|")
            if bits.len() >= 2 && bits[0] != "" { names[bits[0]] = bits[1] }
        }
    }
    refresh_lang_face()
    ui.lang_menu.set_visible(false)
    ui.lang_custom.set_visible(lang_is_other)
    if lang_is_other { ui.custom_field.set_text(custom_lang) }
}
fn save_names(){
    let text = ""
    for a in accounts {
        let custom = names[a.id]
        if custom != nil && custom != "" {
            if text != "" { text = text + "\n" }
            text = text + a.id + "|" + custom
        }
    }
    fs.write("names.txt", text)
}
fn begin_rename(id){
    renaming = id
    rename_text = ""
    for a in accounts {
        if a.id == id { rename_text = display_name(a) }
    }
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn commit_rename(){
    if renaming == "" { return }
    finish_rename(renaming, rename_text)
}
fn finish_rename(id, text){
    names[id] = text.trim()
    renaming = ""
    rename_text = ""
    save_names()
    ui.rail_slot.render()
    ui.settings_accounts.render()
}
fn is_open(id){
    if open_by[id] == nil { return true }
    return open_by[id]
}
fn show_heading(){
    ui.title.set_text(folder.name)
    if account == nil { ui.address.set_text("") }
    else { ui.address.set_text(account.address) }
}
fn load_accounts(){
    host.request("mail.accounts", {}, fn(r){
        if r.is_ok && r.data.len() > 0 {
            accounts = r.data
            let keep = false
            if account != nil {
                for a in accounts { if a.id == account.id { keep = true } }
            }
            if !keep {
                account = accounts[0]
                folder = {id: "INBOX" name: "Inbox"}
            }
            pane("inbox")
            show_heading()
            ui.rail_slot.render()
            for a in accounts {
                if open_by[a.id] == nil { open_by[a.id] = true }
                load_folders(a.id)
            }
            list()
            sync()
            if ui.settings_pane.visible() { ui.settings_accounts.render() }
        } else {
            accounts = []
            account = nil
            messages = []
            pane("welcome")
        }
    })
}
fn add_account(){
    status("Sign in on the sheet OctoSense shows.")
    ui.welcome_note.set_text("Sign in on the sheet OctoSense shows.")
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { load_accounts() }
        else {
            status(r.error)
            ui.welcome_note.set_text(r.error)
        }
    })
}
fn toggle_account(id){
    open_by[id] = !is_open(id)
    ui.rail_slot.render()
}
fn load_folders(id){
    host.request("mail.folders", {account: id}, fn(r){
        if r.is_ok {
            folders_by[id] = r.data
            ui.rail_slot.render()
        }
    })
}
fn select_named(aid, fid, fname){
    for a in accounts {
        if a.id == aid { account = a }
    }
    folder = {id: fid name: fname}
    messages = []
    close_detail()
    show_heading()
    ui.rail_slot.render()
    paint_rows()
    list()
    sync()
}
fn select_folder(a, f){
    select_named(a.id, f.id, f.name)
}
fn sync(){
    if account == nil || busy { return }
    busy = true
    status("Checking for mail…")
    host.request("mail.sync", {account: account.id folder: folder.id}, fn(r){
        busy = false
        if r.is_ok {
            if r.data.new == 1 { status("1 new message") }
            else if r.data.new > 0 { status("" + r.data.new + " new messages") }
            else { status("Up to date") }
            list()
        } else { status(r.error) }
    })
}
fn load_classes(){
    classes = {}
    if !fs.exists("classes.txt") { return }
    let lines = fs.read("classes.txt").split("\n")
    for line in lines {
        let bits = line.split("|")
        if bits.len() >= 2 && bits[0] != "" { classes[bits[0]] = bits[1] }
    }
}
fn save_classes(){
    let text = ""
    for m in recent {
        let c = classes[m.id]
        if c != nil && c != "" {
            if text != "" { text = text + "\n" }
            text = text + m.id + "|" + c
        }
    }
    fs.write("classes.txt", text)
}
fn folder_names(){
    if account == nil { return "" }
    let found = folders_by[account.id]
    if found == nil { return "" }
    let t = ""
    for f in found {
        if t != "" { t = t + ", " }
        t = t + f.name
    }
    return t
}
fn name_ok(name){
    if account == nil { return false }
    let found = folders_by[account.id]
    if found == nil { return false }
    for f in found { if f.name == name { return true } }
    return false
}
fn paint_rows(){
    total = messages.len()
    show_heading()
    if messages.len() == 0 {
        ui.rows.set_visible(false)
        ui.rows_empty.set_visible(true)
    } else {
        ui.rows_empty.set_visible(false)
        ui.rows.set_visible(true)
        ui.rows.render()
    }
    status(folder.name + " · " + messages.len())
}
fn show_current(raw){
    messages = raw
    paint_rows()
}
fn classify_some(){
    if classifying || account == nil { return }
    if folder_names() == "" { return }
    let pending = []
    let i = 0
    for m in recent {
        if i < classify_goal {
            if classes[m.id] == nil || classes[m.id] == "" { pending.push(m) }
        }
        i = i + 1
    }
    if pending.len() == 0 { show_current(messages); return }
    let n = pending.len()
    if n > 20 { n = 20 }
    let batch = ""
    for i in n {
        let m = pending[i]
        batch = batch + m.id + " | " + m.sender + " | " + m.subject + "\n"
    }
    let allowed = folder_names()
    classifying = true
    status("Classifying the latest mail…")
    host.request("model.complete", {
        task: "Classify each email into one existing mailbox folder. For every line, reply with one line id|Folder. Folder must be copied exactly from the allowed list. Do not invent a folder name. Return every id. No other text."
        input: {allowed: allowed mail: batch}
        schema: answer_schema()
        class: "fast"
    }, fn(r){
        classifying = false
        let got = 0
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.answer != nil {
            let lines = r.data.output.answer.split("\n")
            for line in lines {
                let bits = line.split("|")
                if bits.len() >= 2 && name_ok(bits[1].trim()) {
                    classes[bits[0].trim()] = bits[1].trim()
                    got = got + 1
                }
            }
            save_classes()
        }
        show_current(messages)
        if got > 0 { classify_some() }
    })
}
fn list(){
    if account == nil { return }
    let wanted = "" + folder.id
    let wanted_name = "" + folder.name
    host.request("mail.list", {account: account.id folder: wanted offset: 0 limit: 100}, fn(r){
        if ("" + folder.id) != wanted { return }
        if !r.is_ok { status(r.error); return }
        if r.data != nil && r.data.folder != nil && ("" + r.data.folder) != wanted { return }
        let raw = []
        if r.data != nil && r.data.messages != nil { raw = r.data.messages }
        if wanted == "INBOX" || wanted_name == "Inbox" { recent = raw }
        show_current(raw)
    })
}
fn open_message(m){
    open_id = m.id
    host.request("mail.message", {account: account.id folder: folder.id message: m.id}, fn(r){
        if r.is_ok {
            reading = r.data
            ui.r_subject.set_text(r.data.subject)
            ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
            ui.r_time.set_text(r.data.time)
            // Formatted mail shows as the host rebuilt it: text, links and
            // lists, nothing remote.
            let formatted = r.data.html != ""
            ui.r_html.set_visible(formatted)
            ui.r_body.set_visible(!formatted)
            if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_body.set_text(r.data.body) }
            let names = ""
            for a in r.data.attachments {
                if names != "" { names = names + ", " }
                names = names + a.filename + " (" + kb(a.size) + ")"
            }
            ui.r_attachments.set_visible(names != "")
            ui.r_attachments.set_text("Attachments: " + names)
            show_reader()
            m.unread = false
            host.request("mail.mark_read", {account: account.id folder: folder.id message: m.id}, fn(done){
                if !done.is_ok { status(done.error) }
            })
        } else { status(r.error) }
    })
}
fn compose(to, subject, body){
    ui.c_to.set_text(to)
    ui.c_subject.set_text(subject)
    ui.c_body.set_text(body)
    ui.c_note.set_text("")
    show_composer()
}
fn reply(){
    if reading == nil { return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    compose_kind = "reply"
    compose(reading.address, subject, "")
}
fn send(){
    if account == nil { return }
    ui.c_note.set_text("Sending…")
    host.request("mail.send", {account: account.id to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text()}, fn(r){
        if r.is_ok { status("Sent"); close_detail(); ui.rows.render() } else { ui.c_note.set_text(r.error) }
    })
}
fn remove_account(id){
    if id == "" { return }
    host.request("mail.remove_account", {account: id}, fn(r){
        if r.is_ok { load_accounts() } else { status(r.error) }
    })
}
fn ask_remove(a){
    commit_rename()
    pending_remove = a.id
    ui.confirm_name.set_text(display_name(a))
    ui.confirm.set_visible(true)
}
fn cancel_remove(){
    pending_remove = ""
    ui.confirm.set_visible(false)
}
fn confirm_remove(){
    let id = pending_remove
    pending_remove = ""
    ui.confirm.set_visible(false)
    remove_account(id)
}
fn show_tab(name){
    commit_rename()
    settings_tab = name
    ui.account_tab.set_visible(name == "account")
    ui.agent_tab.set_visible(name == "agent")
    if name == "agent" { refresh_provider() }
    ui.settings_accounts.render()
}
fn show_settings(){
    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(true)
    ui.confirm.set_visible(false)
    show_tab("account")
}
fn open_settings(){
    commit_rename()
    if ui.settings_pane.visible() { close_detail(); return }
    show_settings()
}
fn back_to_inbox(){ close_detail(); ui.rows.render() }
fn kb(n){
    if n > 1000000 { return "" + floor(n / 100000) / 10 + " MB" }
    return "" + (floor(n / 1000) + 1) + " KB"
}
fn folder_selected(a, f){
    if account == nil { return false }
    return account.id == a.id && folder.id == f.id
}

fn toggle_agent(){
    agent_open = !agent_open
    ui.agent_slim.set_visible(!agent_open)
    ui.agent_panel.set_visible(agent_open)
}
fn answer_schema(){
    return {type: "object" required: ["answer"] additionalProperties: false
        properties: {answer: {type: "string" minLength: 1 maxLength: 4000}}}
}
fn take_answer(r){
    if !r.is_ok { return r.error }
    if r.data != nil && r.data.output != nil && r.data.output.answer != nil {
        return r.data.output.answer
    }
    return "The model returned no answer."
}
fn refresh_provider(){
    ui.api_status.set_text("Testing the connection…")
    host.request("model.complete", {
        task: "Reply with the word ok."
        input: {ping: "ok"}
        schema: answer_schema()
        class: "fast"
    }, fn(s){
        if s.is_ok { ui.api_status.set_text("Connected · using the model in AI providers") }
        else { ui.api_status.set_text(s.error) }
    })
}
fn plan_schema(){
    return {type: "object" required: ["stop" "tools" "since" "until" "span" "to" "subject" "body" "query" "answer"] additionalProperties: false
        properties: {
            stop: {type: "string" enum: ["continue" "Finish" "结束"]}
            tools: {type: "string" maxLength: 240}
            since: {type: "string" maxLength: 40}
            until: {type: "string" maxLength: 40}
            span: {type: "string" maxLength: 80}
            to: {type: "string" maxLength: 200}
            subject: {type: "string" maxLength: 300}
            body: {type: "string" maxLength: 4000}
            query: {type: "string" maxLength: 120}
            answer: {type: "string" maxLength: 4000}
        }}
}
fn event_schema(){
    return {type: "object" required: ["found" "title" "start" "end" "location"] additionalProperties: false
        properties: {
            found: {type: "string" enum: ["yes" "no"]}
            title: {type: "string" maxLength: 200}
            start: {type: "string" maxLength: 80}
            end: {type: "string" maxLength: 80}
            location: {type: "string" maxLength: 200}
        }}
}
fn translate_schema(){
    return {type: "object" required: ["status" "subject" "text"] additionalProperties: false
        properties: {
            status: {type: "string" enum: ["translated" "already"]}
            subject: {type: "string" maxLength: 300}
            text: {type: "string" maxLength: 8000}
        }}
}
fn pack(text){
    if text == nil { return "" }
    let parts = text.split("\n")
    let out = ""
    for p in parts {
        let clean = p.replace("|", "/")
        if out != "" { out = out + "¬" }
        out = out + clean
    }
    return out
}
fn unpack(text){
    if text == nil { return "" }
    let parts = text.split("¬")
    let out = ""
    for p in parts {
        if out != "" { out = out + "\n" }
        out = out + p
    }
    return out
}
fn mail_key(){
    if reading == nil || account == nil { return "" }
    return account.id + "~" + folder.id + "~" + reading.id
}
fn remember_sum(key, text){
    saved_sum[key] = text
    let found = false
    for k in sum_keys { if k == key { found = true } }
    if !found { sum_keys.push(key) }
}
fn remember_trans(key, lang, subject, text){
    saved_trans[key] = text
    saved_subject[key] = subject
    saved_trans_lang[key] = lang
    let found = false
    for k in trans_keys { if k == key { found = true } }
    if !found { trans_keys.push(key) }
}
fn load_tools(){
    if fs.exists("lang.txt") {
        let line = fs.read("lang.txt").trim()
        let other = line.strip_prefix("other|")
        if other != line {
            lang_is_other = true
            custom_lang = other
            if other != "" { target_lang = other }
        } else if line != "" {
            lang_is_other = false
            target_lang = line
        }
    }
    if !fs.exists("tools.txt") { return }
    let lines = fs.read("tools.txt").split("\n")
    for line in lines {
        if line.search("S|") == 0 {
            let bits = line.strip_prefix("S|").split("|")
            if bits.len() >= 2 { remember_sum(bits[0], unpack(bits[1])) }
        }
        if line.search("T|") == 0 {
            let bits = line.strip_prefix("T|").split("|")
            if bits.len() >= 4 { remember_trans(bits[0], bits[1], unpack(bits[2]), unpack(bits[3])) }
        }
    }
}
fn refresh_lang_face(){
    let shown = target_lang
    if lang_is_other { shown = "Other" }
    ui.lang_name.set_text(shown)
    if lang_open { ui.lang_mark.set_text("▴") }
    else { ui.lang_mark.set_text("▾") }
}
fn toggle_lang_menu(){
    lang_open = !lang_open
    ui.lang_menu.set_visible(lang_open)
    refresh_lang_face()
}
fn pick_lang(i){
    let name = lang_labels[i]
    lang_open = false
    ui.lang_menu.set_visible(false)
    if name == "Other" {
        lang_is_other = true
        ui.lang_custom.set_visible(true)
        if custom_lang != "" { target_lang = custom_lang }
        fs.write("lang.txt", "other|" + custom_lang)
    } else {
        lang_is_other = false
        ui.lang_custom.set_visible(false)
        target_lang = name
        fs.write("lang.txt", name)
    }
    refresh_lang_face()
}
fn save_custom(text){
    custom_lang = text.trim()
    if custom_lang != "" { target_lang = custom_lang }
    fs.write("lang.txt", "other|" + custom_lang)
}
fn save_tools(){
    let text = ""
    for k in sum_keys {
        if saved_sum[k] != nil {
            if text != "" { text = text + "\n" }
            text = text + "S|" + k + "|" + pack(saved_sum[k])
        }
    }
    for k in trans_keys {
        if saved_trans[k] != nil {
            if text != "" { text = text + "\n" }
            let lang = saved_trans_lang[k]
            if lang == nil { lang = target_lang }
            let sub = saved_subject[k]
            if sub == nil { sub = "" }
            text = text + "T|" + k + "|" + lang + "|" + pack(sub) + "|" + pack(saved_trans[k])
        }
    }
    fs.write("tools.txt", text)
}
fn load_events(){
    saved_events = []
    if !fs.exists("events.txt") { return }
    let lines = fs.read("events.txt").split("\n")
    for line in lines {
        if line == "" { continue }
        let bits = line.split("|")
        if bits.len() >= 4 {
            let key = ""
            if bits.len() >= 5 { key = unpack(bits[4]) }
            saved_events.push({title: unpack(bits[0]) start: unpack(bits[1]) end: unpack(bits[2]) location: unpack(bits[3]) key: key})
        }
    }
}
fn save_events(){
    let text = ""
    for e in saved_events {
        if text != "" { text = text + "\n" }
        text = text + pack(e.title) + "|" + pack(e.start) + "|" + pack(e.end) + "|" + pack(e.location) + "|" + pack(e.key)
    }
    fs.write("events.txt", text)
}
fn event_brief(){
    if pending_event == nil { return "" }
    let place = pending_event.location
    if place == nil { place = "" }
    return pending_event.title + " | " + pending_event.start + " – " + pending_event.end + " | " + place
}
fn event_saved(title, start){
    for e in saved_events {
        if e.title == title && e.start == start { return true }
    }
    return false
}
fn commit_event(){
    if pending_event == nil { return "There is no schedule waiting." }
    let title = pending_event.title
    let start = pending_event.start
    let end = pending_event.end
    let location = pending_event.location
    let key = pending_event.key
    if key == nil { key = "" }
    if location == nil { location = "" }
    let shown = title + "\n" + start + " – " + end
    if location != "" { shown = shown + "\n" + location }
    if event_saved(title, start) {
        pending_event = nil
        return "Already on the calendar.\n" + shown
    }
    saved_events.push({title: title start: start end: end location: location key: key})
    save_events()
    pending_event = nil
    return "Added to the calendar.\n" + shown
}
fn agrees(text){
    let t = text.trim()
    if t == "要" || t == "要的" || t == "是" || t == "好" || t == "好的" || t == "可以" || t == "加入" || t == "添加" || t == "要添加" { return true }
    if t == "yes" || t == "Yes" || t == "YES" || t == "y" || t == "Y" || t == "ok" || t == "OK" || t == "okay" || t == "Okay" || t == "add" || t == "Add" { return true }
    return false
}
fn declines(text){
    let t = text.trim()
    if t == "不要" || t == "不用" || t == "否" || t == "取消" { return true }
    if t == "no" || t == "No" || t == "NO" || t == "cancel" || t == "Cancel" { return true }
    return false
}
fn at_tail(){
    let y = try { ui.chat_view.scroll_y() } catch { -1 }
    if y < 0 { return true }
    let max = try { ui.chat_view.scroll_max_y() } catch { -1 }
    if max < 0 { return true }
    if max <= 12 { return true }
    return y + 36 >= max
}
fn paint_chat(){
    if !follow_locked {
        chat_follow = at_tail()
        follow_locked = true
        start_timeout(0.4, || { follow_locked = false })
    }
    ui.chat_view.render()
    follow_gen = follow_gen + 1
    if !chat_follow { return }
    let token = follow_gen
    start_timeout(0.15, || {
        if token != follow_gen { return }
        try { ui.chat_view.set_scroll_y(1000000) } catch { 0 }
        start_timeout(0.25, || {
            if token != follow_gen { return }
            try { ui.chat_view.set_scroll_y(1000000) } catch { 0 }
        })
    })
}
fn show_agent(){
    agent_open = true
    ui.agent_slim.set_visible(false)
    ui.agent_panel.set_visible(true)
}
fn paint_mail(){
    if reading == nil { return }
    let key = mail_key()
    if view_trans[key] == "1" && saved_trans[key] != nil && saved_trans_lang[key] == target_lang {
        ui.r_html.set_text("")
        ui.r_html.set_visible(false)
        ui.r_body.set_visible(true)
        ui.r_body.set_text(saved_trans[key])
        if saved_subject[key] != nil && saved_subject[key] != "" { ui.r_subject.set_text(saved_subject[key]) }
    } else {
        ui.r_subject.set_text(reading.subject)
        let formatted = reading.html != nil && reading.html != ""
        ui.r_html.set_visible(formatted)
        ui.r_body.set_visible(!formatted)
        if formatted { ui.r_html.set_text(reading.html) }
        else { ui.r_body.set_text(reading.body) }
    }
    let sum = saved_sum[key]
    let has = sum != nil && sum != ""
    ui.summary_rule.set_visible(has)
    ui.r_summary.set_visible(has)
    if has { ui.r_summary.set_text(sum) }
    refresh_translate_btn()
}
fn refresh_translate_btn(){
    let label = "Translate"
    if trans_busy { label = "Translating…" }
    else if reading != nil && view_trans[mail_key()] == "1" { label = "Show original" }
    ui.translate_btn.set_text(label)
}
fn one_line(text){
    if text == nil { return "" }
    let parts = text.split("\n")
    let out = ""
    for p in parts {
        if out != "" { out = out + " " }
        out = out + p
    }
    return out
}
fn load_chats(){
    sessions = []
    if !fs.exists("chats.txt") { return }
    let lines = fs.read("chats.txt").split("\n")
    let title = ""
    let body = ""
    let open = false
    for line in lines {
        if line.search("@|") == 0 {
            if open { sessions.push({title: title body: body}) }
            let bits = line.split("|")
            title = ""
            if bits.len() >= 2 { title = bits[1] }
            body = ""
            open = true
        } else if open && line != "" {
            if body != "" { body = body + "\n" }
            body = body + line
        }
    }
    if open { sessions.push({title: title body: body}) }
}
fn save_chats(){
    let text = ""
    for s in sessions {
        if text != "" { text = text + "\n" }
        text = text + "@|" + one_line(s.title)
        if s.body != "" { text = text + "\n" + s.body }
    }
    fs.write("chats.txt", text)
}
fn remember_session(){
    if chat_log.len() == 0 { return }
    let title = ""
    for m in chat_log {
        if title == "" && m.role == "user" { title = clip(m.text, 42) }
    }
    let body = ""
    for m in chat_log {
        let tag = "A|"
        if m.role == "user" { tag = "U|" }
        if body != "" { body = body + "\n" }
        body = body + tag + one_line(m.text)
    }
    if active_session < 0 {
        sessions.push({title: title body: body})
        active_session = sessions.len() - 1
    } else {
        let next = []
        for i in sessions.len() {
            if i == active_session { next.push({title: title body: body}) }
            else { next.push(sessions[i]) }
        }
        sessions = next
    }
    save_chats()
}
fn restore_session(i){
    let s = sessions[i]
    if s == nil { return }
    chat_log = []
    let lines = s.body.split("\n")
    for line in lines {
        let user = line.strip_prefix("U|")
        if user != line { chat_log.push({role: "user" text: user}) }
        else {
            let agent = line.strip_prefix("A|")
            if agent != line { chat_log.push({role: "agent" text: agent}) }
        }
    }
    active_session = i
    history_open = false
    ui.history_pane.set_visible(false)
    paint_chat()
}
fn new_chat(){
    remember_session()
    chat_log = []
    active_session = -1
    history_open = false
    ui.history_pane.set_visible(false)
    paint_chat()
}
fn toggle_history(){
    history_open = !history_open
    ui.history_pane.set_visible(history_open)
    if history_open { ui.history_list.render() }
}
fn clip(text, n){
    if text == nil { return "" }
    if text.len() <= n { return text }
    let lines = text.split("\n")
    let out = ""
    for line in lines {
        if (out + line).len() > n {
            if out == "" { return "…" }
            return out + "\n…"
        }
        if out != "" { out = out + "\n" }
        out = out + line
    }
    return out
}
fn message_context(){
    if reading == nil { return "No message is open. Say that you cannot see a message." }
    return "Subject: " + reading.subject + "\nFrom: " + reading.sender + " <" + reading.address + ">\nDate: " + reading.time + "\n\n" + clip(strip_tags(reading.body), 6000)
}
fn mailbox_digest(list, title){
    let t = "Account: " + account.address + "\n" + title + "\nThese are messages already on this device, not the full mailbox history.\n"
    let n = list.len()
    if n > 24 { n = 24 }
    for i in n {
        let m = list[i]
        let preview = ""
        if m.preview != nil { preview = clip(m.preview, 80) }
        t = t + "- " + m.time + " | " + m.sender + " | " + m.subject + " | " + preview + "\n"
    }
    if n == 0 { t = t + "(no messages)\n" }
    return clip(t, 8000)
}
fn history_text(){
    let t = ""
    let start = 0
    if chat_log.len() > 16 { start = chat_log.len() - 16 }
    for i in chat_log.len() {
        if i >= start {
            let m = chat_log[i]
            t = t + m.role + ": " + clip(m.text, 800) + "\n"
        }
    }
    return t
}
fn pick_messages(list, since, until){
    if since == "" && until == "" { return list }
    let kept = []
    for m in list {
        let t = ""
        if m.time != nil { t = m.time }
        let hit = false
        if since != "" && t.search(since) >= 0 { hit = true }
        if until != "" && t.search(until) >= 0 { hit = true }
        if hit { kept.push(m) }
    }
    if kept.len() == 0 { return list }
    return kept
}
fn finish_turn(text){
    agent_busy = false
    ui.agent_note.set_text("")
    chat_log.push({role: "agent" text: text})
    remember_session()
    paint_chat()
}
fn open_hint(){
    if reading == nil { return "none" }
    return reading.subject + " | " + reading.time
}
fn clean_answer(text){
    if text == nil { return "" }
    let t = text.trim()
    let a = t.strip_suffix("Finish")
    if a != t { t = a.trim() }
    let b = t.strip_suffix("结束")
    if b != t { t = b.trim() }
    return t
}
fn is_stop(stop){
    return stop == "Finish" || stop == "结束"
}
fn strip_tags(text){
    if text == nil { return "" }
    return text.replace(regex("<[^>]+>", "g"), " ")
}
fn screen_now(){
    if ui.composer.visible() {
        if compose_kind == "reply" { return "reply composer" }
        return "new message composer"
    }
    if ui.reader.visible() { return "open message" }
    if ui.settings_pane.visible() { return "settings" }
    return "mail list"
}
fn finish_tool(text){
    if !in_chain { finish_turn(text); return }
    if chain_log != "" { chain_log = chain_log + "\n" }
    chain_log = chain_log + text
    chain_i = chain_i + 1
    run_chain()
}
fn observe(text){
    if react_trace != "" { react_trace = react_trace + "\n" }
    react_trace = react_trace + "Observation: " + clip(text, 2500)
    react_next()
}
fn react_next(){
    if react_step >= 10 {
        finish_turn("Could not finish this request.")
        return
    }
    react_step = react_step + 1
    ui.agent_note.set_text("Thinking…")
    host.request("model.complete", {
        task: "You are AgentMail in a ReAct loop. The language field is the person's chosen language. Write answer in that language. Write any email subject and body you put in subject and body in that language too. Current screen: the value of screen. You can open the mail list, one message, the reply composer, or the new-message composer. tools is a comma-separated list run in order, or empty. Tools: read_message, read_mailbox, read_range, summarize, translate, show_original, find_event, add_event, open_reply, open_compose, write_reply, write_mail, open_mail, classify, classify_more. classify sorts the latest 100 messages into the account's existing folders, and only when the user asks. classify_more does the next 100, and only when the user asks for more. Never classify on your own. find_event reads a schedule from the open mail. add_event writes the schedule already in the pending field, and only after the user has agreed in their own later message. When the question is Recognize, call summarize then find_event before Finish. If a schedule was found, the answer must show its title, start, end, and location, then ask whether to add it. Do not call add_event during Recognize. When the user agrees, call add_event. History is the earlier chat. Use it, and use pending, so you know which schedule they mean. For write_reply and write_mail put the draft in to, subject, and body. For open_mail put words from the subject or sender in query. since, until, and span are only for read_range. After you see an observation, you may return another list. Set stop to Finish or 结束 only when answer is the reply for the user. Do not put Finish inside answer."
        input: {question: pending_q screen: screen_now() open: open_hint() language: target_lang history: clip(history_text(), 4000) pending: event_brief() observations: clip(react_trace, 6000) step: react_step}
        schema: plan_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        if !r.is_ok { finish_turn(r.error); return }
        let stop = "continue"
        let tools = ""
        let since = ""
        let until = ""
        let span = ""
        let answer = ""
        arg_to = ""
        arg_subject = ""
        arg_body = ""
        arg_query = ""
        arg_since = ""
        arg_until = ""
        arg_span = ""
        if r.data != nil && r.data.output != nil {
            if r.data.output.stop != nil { stop = r.data.output.stop }
            if r.data.output.tools != nil { tools = r.data.output.tools }
            if r.data.output.since != nil { since = r.data.output.since }
            if r.data.output.until != nil { until = r.data.output.until }
            if r.data.output.span != nil { span = r.data.output.span }
            arg_since = since
            arg_until = until
            arg_span = span
            if r.data.output.to != nil { arg_to = r.data.output.to }
            if r.data.output.subject != nil { arg_subject = r.data.output.subject }
            if r.data.output.body != nil { arg_body = r.data.output.body }
            if r.data.output.query != nil { arg_query = r.data.output.query }
            if r.data.output.answer != nil { answer = r.data.output.answer }
        }
        if is_stop(stop) {
            if pending_q == "Recognize" && react_step < 4 && react_trace.search("Schedule found") < 0 && react_trace.search("No schedule") < 0 {
                observe("Recognize is not finished. Call summarize, then find_event. Do not add the event yet.")
                return
            }
            let shown = clean_answer(answer)
            if shown == "" { shown = "Done." }
            finish_turn(shown)
            return
        }
        let names = []
        if tools != nil && tools != "" { names = tools.split(",") }
        if names.len() == 0 {
            observe("No tool ran. Return a tool list, or set stop to Finish or 结束 when the answer is ready.")
            return
        }
        in_chain = true
        chain_names = names
        chain_i = 0
        chain_log = ""
        run_chain()
    })
}
fn after_plan(kind, since, until, span){
    if kind == "message" && reading != nil {
        finish_tool(message_context())
        return
    }
    host.request("mail.list", {account: account.id folder: "INBOX" offset: 0 limit: 60}, fn(r){
        let list = messages
        if r.is_ok && r.data != nil && r.data.messages != nil { list = r.data.messages }
        let title = "Inbox"
        if kind == "range" {
            list = pick_messages(list, since, until)
            title = "Period " + span
        }
        finish_tool(mailbox_digest(list, title))
    })
}
fn tool_read_message(){
    if reading == nil { after_plan("mailbox", "", "", ""); return }
    finish_tool(message_context())
}
fn tool_read_mailbox(){
    after_plan("mailbox", "", "", "")
}
fn tool_read_range(since, until, span){
    after_plan("range", since, until, span)
}
fn tool_show_original(){
    if reading == nil { finish_tool("No message is open."); return }
    view_trans[mail_key()] = ""
    paint_mail()
    finish_tool("The original subject and body are on screen.")
}
fn tool_summarize(){
    if reading == nil { finish_tool("No message is open, so it was not summarized."); return }
    let key = mail_key()
    if saved_sum[key] != nil && saved_sum[key] != "" {
        paint_mail()
        finish_tool(saved_sum[key])
        return
    }
    if react_step >= 10 { finish_tool("Step limit reached before summarize."); return }
    react_step = react_step + 1
    ui.agent_note.set_text("Thinking…")
    host.request("model.complete", {
        task: "Summarize this email in " + target_lang + ". Put only the summary in answer. Do not invent facts."
        input: {subject: reading.subject from: reading.sender body: clip(reading.body, 6000)}
        schema: answer_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        let text = take_answer(r)
        if r.is_ok { remember_sum(key, text); save_tools(); paint_mail() }
        finish_tool(text)
    })
}
fn tool_find_event(){
    if reading == nil { pending_event = nil; finish_tool("No schedule. No message is open."); return }
    if react_step >= 10 { finish_tool("Step limit reached before the schedule check."); return }
    react_step = react_step + 1
    ui.agent_note.set_text("Thinking…")
    let key = mail_key()
    host.request("model.complete", {
        task: "Decide whether this email contains one calendar event, such as a meeting, appointment, delivery window, flight, reservation, or a deadline that has a date or a time. If it does, set found to yes and copy the title, start, end, and location from the mail. Keep the dates and times that are written in the mail. If an end is missing, leave end empty. If there is no schedule, set found to no and leave the other fields empty. Do not invent a time or a place."
        input: {subject: reading.subject from: reading.sender body: clip(strip_tags(reading.body), 6000)}
        schema: event_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        if !r.is_ok { pending_event = nil; finish_tool(r.error); return }
        let found = "no"
        let title = ""
        let start = ""
        let end = ""
        let location = ""
        if r.data != nil && r.data.output != nil {
            if r.data.output.found != nil { found = r.data.output.found }
            if r.data.output.title != nil { title = r.data.output.title }
            if r.data.output.start != nil { start = r.data.output.start }
            if r.data.output.end != nil { end = r.data.output.end }
            if r.data.output.location != nil { location = r.data.output.location }
        }
        if found != "yes" || title == "" || start == "" {
            pending_event = nil
            finish_tool("No schedule in this mail.")
            return
        }
        pending_event = {title: title start: start end: end location: location key: key}
        finish_tool("Schedule found. Title: " + title + ". Start: " + start + ". End: " + end + ". Location: " + location + ". Show these fields and ask whether to add the event. Do not add it yet.")
    })
}
fn tool_add_event(){
    if !turn_can_add {
        finish_tool("Refused: the user has not agreed yet. Show the schedule and ask. Do not add it during Recognize.")
        return
    }
    if pending_event == nil {
        finish_tool("No schedule is waiting. Use the chat history and call find_event on the open mail before adding.")
        return
    }
    finish_tool(commit_event())
}
fn tool_translate(){
    if reading == nil { finish_tool("No message is open, so it was not translated."); return }
    let key = mail_key()
    if saved_trans[key] != nil && saved_trans_lang[key] == target_lang {
        trans_busy = false
        view_trans[key] = "1"
        paint_mail()
        let sub = saved_subject[key]
        if sub == nil { sub = "" }
        finish_tool("Showing the saved " + target_lang + " translation. Subject: " + sub)
        return
    }
    if react_step >= 10 { trans_busy = false; finish_tool("Step limit reached before translate."); return }
    react_step = react_step + 1
    trans_busy = true
    refresh_translate_btn()
    ui.agent_note.set_text("Thinking…")
    host.request("model.complete", {
        task: "Translate the subject and the body into the target language. Put the translated subject in subject and the translated body in text. Do not include the original. If both are already in that language, set status to already and leave subject and text empty."
        input: {language: target_lang subject: reading.subject body: clip(reading.body, 6000)}
        schema: translate_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        trans_busy = false
        if !r.is_ok { paint_mail(); finish_tool(r.error); return }
        let status = ""
        let text = ""
        let subject = ""
        if r.data != nil && r.data.output != nil {
            status = r.data.output.status
            text = r.data.output.text
            subject = r.data.output.subject
        }
        if status == "already" {
            view_trans[key] = ""
            paint_mail()
            finish_tool("Already in " + target_lang + ". The mail was not replaced.")
            return
        }
        if text == nil || text == "" { paint_mail(); finish_tool("The translator returned no body."); return }
        if subject == nil || subject == "" { subject = reading.subject }
        remember_trans(key, target_lang, subject, text)
        view_trans[key] = "1"
        save_tools()
        paint_mail()
        finish_tool("Translated into " + target_lang + ". Subject: " + subject)
    })
}
fn run_chain(){
    if chain_i >= chain_names.len() {
        in_chain = false
        let text = chain_log
        if text == "" { text = "No tool ran." }
        observe(text)
        return
    }
    let name = chain_names[chain_i].trim()
    if name == "" {
        chain_i = chain_i + 1
        run_chain()
        return
    }
    dispatch(name, arg_since, arg_until, arg_span)
}
fn tool_open_reply(){
    if reading == nil { finish_tool("No message is open, so the reply composer was not opened."); return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    compose_kind = "reply"
    compose(reading.address, subject, "")
    finish_tool("Opened the reply composer with an empty body.")
}
fn tool_open_compose(){
    compose_kind = "new"
    let to = arg_to
    let subject = arg_subject
    let body = arg_body
    compose(to, subject, body)
    finish_tool("Opened the new-message composer.")
}
fn tool_write_reply(){
    if arg_body == "" {
        finish_tool("Refused: the reply body was empty. Put the full reply text in body and call write_reply again. Do not finish yet.")
        return
    }
    if reading == nil && compose_kind != "reply" { finish_tool("No message is open to reply to."); return }
    let subject = ""
    let to = ""
    if reading != nil {
        subject = reading.subject
        if subject.search("Re:") != 0 { subject = "Re: " + subject }
        to = reading.address
    }
    if arg_subject != "" { subject = arg_subject }
    if arg_to != "" { to = arg_to }
    compose_kind = "reply"
    if !ui.composer.visible() || ui.c_body.text() == "" {
        compose(to, subject, arg_body)
    } else {
        if to != "" { ui.c_to.set_text(to) }
        if subject != "" { ui.c_subject.set_text(subject) }
        ui.c_body.set_text(arg_body)
    }
    finish_tool("Wrote the reply body into the composer.")
}
fn tool_write_mail(){
    if !ui.composer.visible() || compose_kind != "new" {
        compose_kind = "new"
        compose(arg_to, arg_subject, arg_body)
        finish_tool("Opened a new message and wrote the draft.")
        return
    }
    if arg_to != "" { ui.c_to.set_text(arg_to) }
    if arg_subject != "" { ui.c_subject.set_text(arg_subject) }
    ui.c_body.set_text(arg_body)
    finish_tool("Wrote the draft into the new message.")
}
fn tool_classify(){
    if account == nil { finish_tool("No account is open."); return }
    classify_goal = 100
    host.request("mail.list", {account: account.id folder: "INBOX" offset: 0 limit: 100}, fn(r){
        if !r.is_ok { finish_tool(r.error); return }
        let raw = []
        if r.data != nil && r.data.messages != nil { raw = r.data.messages }
        recent = raw
        classify_some()
        finish_tool("Classifying the latest 100 messages into the existing folders.")
    })
}
fn tool_classify_more(){
    classify_goal = classify_goal + 100
    if account == nil { finish_tool("No account is open."); return }
    let offset = recent.len()
    host.request("mail.list", {account: account.id folder: "INBOX" offset: offset limit: 100}, fn(r){
        if !r.is_ok { finish_tool(r.error); return }
        let more = []
        if r.data != nil && r.data.messages != nil { more = r.data.messages }
        for m in more { recent.push(m) }
        classify_some()
        finish_tool("Classifying " + classify_goal + " recent messages into the existing folders.")
    })
}
fn tool_open_mail(){
    let q = arg_query.trim()
    if q == "" { finish_tool("No message was named."); return }
    host.request("mail.list", {account: account.id folder: "INBOX" offset: 0 limit: 60}, fn(r){
        let list = messages
        if r.is_ok && r.data != nil && r.data.messages != nil { list = r.data.messages }
        let found = nil
        for m in list {
            let hit = false
            if m.subject != nil && m.subject.search(q) >= 0 { hit = true }
            if m.sender != nil && m.sender.search(q) >= 0 { hit = true }
            if hit { found = m }
        }
        if found == nil { finish_tool("No message matched " + q + "."); return }
        open_message(found)
        finish_tool("Opened the message: " + found.subject)
    })
}
fn open_draft_sheet(){
    if agent_busy || account == nil { return }
    ui.draft_idea.set_text("")
    ui.draft_sheet.set_visible(true)
}
fn close_draft_sheet(){
    ui.draft_sheet.set_visible(false)
}
fn send_draft_idea(){
    let idea = ui.draft_idea.text().trim()
    if idea == "" { idea = "Let AI decide" }
    ui.draft_sheet.set_visible(false)
    ask_draft(idea)
}
fn ask_draft(idea){
    if agent_busy || account == nil { return }
    if compose_kind == "reply" || ui.reader.visible() {
        if reading == nil { ui.agent_note.set_text("Open a message first."); return }
        let subject = reading.subject
        if subject.search("Re:") != 0 { subject = "Re: " + subject }
        compose_kind = "reply"
        if !ui.composer.visible() { compose(reading.address, subject, "") }
    }
    show_agent()
    pending_q = idea
    react_step = 0
    react_trace = ""
    in_chain = false
    chat_log.push({role: "user" text: idea})
    paint_chat()
    agent_busy = true
    ui.agent_note.set_text("Thinking…")
    let mail = ""
    if reading != nil { mail = message_context() }
    host.request("model.complete", {
        task: "Write only the email body in " + target_lang + ". If the note is Let AI decide, write a suitable message from the mail context. Do not include a subject line. Put the body in answer."
        input: {note: idea mail: clip(mail, 6000)}
        schema: answer_schema()
        class: "fast"
        allow_urls: true
    }, fn(r){
        if !r.is_ok { finish_turn(r.error); return }
        let text = take_answer(r)
        ui.c_body.set_text(text)
        finish_turn(text)
    })
}
fn dispatch(tool, since, until, span){
    if tool == "summarize" { tool_summarize(); return }
    if tool == "find_event" { tool_find_event(); return }
    if tool == "add_event" { tool_add_event(); return }
    if tool == "translate" { tool_translate(); return }
    if tool == "show_original" { tool_show_original(); return }
    if tool == "read_mailbox" { tool_read_mailbox(); return }
    if tool == "read_range" { tool_read_range(since, until, span); return }
    if tool == "read_message" { tool_read_message(); return }
    if tool == "open_reply" { tool_open_reply(); return }
    if tool == "open_compose" { tool_open_compose(); return }
    if tool == "write_reply" { tool_write_reply(); return }
    if tool == "write_mail" { tool_write_mail(); return }
    if tool == "open_mail" { tool_open_mail(); return }
    if tool == "classify_more" { tool_classify_more(); return }
    if tool == "classify" { tool_classify(); return }
    finish_tool("Unknown tool " + tool)
}
fn begin_tool(label){
    if agent_busy || account == nil { return }
    if reading == nil { return }
    show_agent()
    pending_q = label
    react_step = 0
    react_trace = ""
    in_chain = false
    turn_can_add = false
    chat_log.push({role: "user" text: label})
    paint_chat()
    agent_busy = true
    if label == "Translate" { dispatch("translate", "", "", "") }
    else { react_next() }
}
fn click_translate(){
    if trans_busy { return }
    if reading == nil { show_agent(); ui.agent_note.set_text("Open a message first."); return }
    if view_trans[mail_key()] == "1" {
        view_trans[mail_key()] = ""
        paint_mail()
        return
    }
    show_agent()
    pending_q = "Translate"
    react_step = 0
    react_trace = ""
    in_chain = false
    agent_busy = false
    trans_busy = true
    refresh_translate_btn()
    ui.agent_note.set_text("Thinking…")
    tool_translate()
}
fn click_recognize(){
    begin_tool("Recognize")
}
fn ask_agent(text){
    if agent_busy { ui.agent_note.set_text("Still working…"); return }
    if account == nil { ui.agent_note.set_text("Add an account first."); return }
    let q = pending_input.trim()
    if text != nil {
        let given = ("" + text).trim()
        if given != "" { q = given }
    }
    if q == "" { q = ui.agent_input.text().trim() }
    if q == "" { return }
    pending_input = ""
    ui.agent_input.set_text("")
    pending_q = q
    react_step = 0
    react_trace = ""
    in_chain = false
    turn_can_add = true
    chat_log.push({role: "user" text: q})
    paint_chat()
    show_agent()
    if pending_event != nil && agrees(q) {
        finish_turn(commit_event())
        return
    }
    if pending_event != nil && declines(q) {
        pending_event = nil
        finish_turn("Not added.")
        return
    }
    agent_busy = true
    react_next()
}

