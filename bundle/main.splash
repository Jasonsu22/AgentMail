                                    } else {
                                        Bar{text: say("re_add") on_click: || set_action_status(action_id, "todo")}
                                    }
                                }
                            }
                        }
                    }
                }}
            }
            reader := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
            btn_back := Bar{text: "‹ 返回" on_click: || back_to_inbox()}
            View{width: Fill height: 1}
            translate_btn := Bar{text: "翻译" on_click: || click_translate()}
            btn_recognize := Bar{text: "AI 总结" on_click: || click_recognize()}
            btn_reply := Bar{text: "回复" on_click: || reply()}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 6
            r_subject := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            r_sender := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
            r_time := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            r_attachments := Label{visible: false width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            r_body := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 15}
            r_html := Html{visible: false width: Fill height: Fit padding: 0 font_color: ink font_size: 15
                draw_text +: {color: ink}
                text_style_normal +: {font_size: 15} text_style_bold +: {font_size: 15}
                text_style_italic +: {font_size: 15} text_style_bold_italic +: {font_size: 15} text_style_fixed +: {font_size: 14}}
            summary_rule := SolidView{visible: false width: Fill height: 1 draw_bg.color: #xe5e5ea}
            r_summary := Label{visible: false width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 15}
            action_panel := View{visible: false width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 8 bottom: 12}
                action_title := Label{width: Fill text: "需要你处理" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                action_rows := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                    let key = mail_key()
                    if visible_action_count(key) == 0 {
                        Label{width: Fill text: say("no_actions") draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                    for item in action_items_for(key) {
                        if item.status != "ignored" {
                            let action_id = item.id
                            let due_text = say("no_due")
                            let due_over = false
                            if item.due_date != nil && item.due_date != "" {
                                due_text = say("due") + item.due_date
                                let due_key = stamp_key(item.due_date)
                                if item.status == "todo" && due_key >= 0 && due_key <= stamp_key(today_stamp()) { due_over = true }
                            } else if item.deadline != "" { due_text = say("due") + item.deadline }
                            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 5 draw_bg +: {color: #xf2f2f7 border_radius: 10.0}
                                View{width: Fill height: Fit flow: Right spacing: 8
                                    Label{width: Fill text: item.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                                    Label{text: action_state_face(item.status) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                }
                                if due_over {
                                    Label{width: Fill text: due_text draw_text.color: #xff3b30 draw_text.text_style: theme.font_bold{font_size: 12}}
                                } else {
                                    Label{width: Fill text: due_text draw_text.color: secondary draw_text.text_style.font_size: 12}
                                }
                                Label{width: Fill text: say("evidence") + item.evidence max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 12}
                                View{width: Fill height: Fit flow: Right spacing: 4
                                    Bar{text: say("source") on_click: || open_action_source(action_id)}
                                    if item.status == "suggested" {
                                        Bar{text: say("add_todo") on_click: || set_action_status(action_id, "todo")}
                                        Bar{text: say("ignore") on_click: || set_action_status(action_id, "ignored")}
                                    } else if item.status == "todo" {
                                        Bar{text: say("complete") on_click: || set_action_status(action_id, "done")}
                                        Bar{text: say("ignore") on_click: || set_action_status(action_id, "ignored")}
                                    } else {
                                        Bar{text: say("reopen") on_click: || set_action_status(action_id, "todo")}
                                    }
                                }
                            }
                        }
                    }
                }}
            }
        }
    }
    composer := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #ffffff padding: Inset{left: 12 right: 12 top: 8} spacing: 8
