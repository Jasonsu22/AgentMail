                            Label{text: say("no_accounts") draw_text.color: secondary draw_text.text_style.font_size: 13}
                        }
                        for a in accounts {
                            View{width: Fill height: Fit flow: Down spacing: 0
                                View{width: Fill height: Fit flow: Right align: Align{y: 0.0} padding: Inset{top: 8 bottom: 2} spacing: 8
                                    View{width: Fill height: Fit flow: Down spacing: 2
                                        if renaming == a.id {
                                            TextInput{width: Fill height: 34 text: rename_text empty_text: say("name") on_change: |text| rename_text = text on_return: |text| finish_rename(a.id, text)
                                                draw_bg +: {color: #xf2f2f7 border_radius: 6.0}
                                                draw_text +: {color: ink text_style +: {font_size: 15}}}
                                        } else {
                                            GestureView{width: Fill height: Fit on_double_tap: |x, y| begin_rename(a.id)
                                                Label{width: Fill text: display_name(a) max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                            }
                                        }
                                        GestureView{width: Fill height: Fit on_tap: |x, y| commit_rename()
                                            Label{width: Fill text: a.address max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 12}
                                        }
                                    }
                                    ButtonFlat{text: say("remove") height: 32 padding: Inset{left: 12 right: 12} on_click: || ask_remove(a)
                                        draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
                                        draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style +: {font_size: 14}}}
                                }
                                SolidView{width: Fill height: 1 draw_bg.color: #xe5e5ea}
                            }
                        }
                        GestureView{width: Fill height: Fill on_tap: |x, y| commit_rename()}
                    }}
                }
                agent_tab := ScrollYView{visible: false width: Fill height: Fill flow: Down spacing: 10 padding: Inset{bottom: 24}
                    api_title := Label{text: "API" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
