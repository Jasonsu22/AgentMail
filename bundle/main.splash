}
fn todo_tab_show(tab){
    todo_tab = tab
    ui.todo_tabs.render()
    ui.todo_rows.render()
}
// 返回 in the to-dos page steps out of a category first; only the pending
// list's 返回 leaves the page.
fn todos_back(){
    if todo_tab != "todo" { todo_tab_show("todo"); return }
    close_detail()
}
fn open_action_source(id){
    let chosen = nil
    for item in action_items { if item.id == id { chosen = item } }
    if chosen == nil { return }
    if chosen.account == "" || chosen.message == "" {
        ui.todos_hint.set_text(say("no_message"))
        return
    }
    let target_account = nil
    for a in accounts { if a.id == chosen.account { target_account = a } }
    if target_account == nil {
        ui.todos_hint.set_text(say("no_message"))
        return
    }
    account = target_account
    let target_folder = {id: chosen.folder name: chosen.folder role: ""}
    let known = folders_by[chosen.account]
    if known != nil {
        for f in known { if f.id == chosen.folder { target_folder = f } }
    }
    folder = target_folder
    open_id = chosen.message
    host.request("mail.message", {account: chosen.account folder: chosen.folder message: chosen.message}, fn(r){
        if !r.is_ok {
            ui.todos_hint.set_text(local_error(r.error))
            return
        }
        reading = r.data
        ui.r_subject.set_text(r.data.subject)
        ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
        ui.r_time.set_text(r.data.time)
        let formatted = r.data.html != ""
        ui.r_html.set_visible(formatted)
        ui.r_body.set_visible(!formatted)
        if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_body.set_text(r.data.body) }
        let attachments = ""
        for a in r.data.attachments {
            if attachments != "" { attachments = attachments + ", " }
            attachments = attachments + a.filename + " (" + kb(a.size) + ")"
        }
        ui.r_attachments.set_visible(attachments != "")
        ui.r_attachments.set_text(say("attachments") + attachments)
        show_heading()
        show_reader()
    })
}
fn open_settings(){
    commit_rename()
    if ui.composer.visible() {
        request_leave("settings", "", "", "")
        return
    }
    if ui.settings_pane.visible() { close_detail(); return }
    show_settings()
}
fn back_to_inbox(){
    if ui.composer.visible() {
        request_leave("inbox", "", "", "")
        return
    }
    close_detail()
    ui.rows.render()
}
fn kb(n){
    if n > 1000000 { return "" + floor(n / 100000) / 10 + " MB" }
    return "" + (floor(n / 1000) + 1) + " KB"
}
fn folder_selected(a, f){
    if account == nil { return false }
    return account.id == a.id && folder.id == f.id
}

fn toggle_agent(){
    agent_open = !agent_open
    ui.agent_slim.set_visible(!agent_open)
    ui.agent_panel.set_visible(agent_open)
}
fn answer_schema(){
    return {type: "object" required: ["answer"] additionalProperties: false
        properties: {answer: {type: "string" minLength: 1 maxLength: 4000}}}
}
fn summary_actions_security_schema(){
    return {type: "object" required: ["summary" "actions" "risk" "evidence" "suspicious_links"] additionalProperties: false
        properties: {
            summary: {type: "string" minLength: 1 maxLength: 4000}
            actions: {type: "array" minItems: 0 maxItems: 6 items: {
                type: "object" required: ["title" "deadline" "evidence" "assignee"] additionalProperties: false
                properties: {
                    title: {type: "string" minLength: 1 maxLength: 180}
                    deadline: {type: "string" maxLength: 100}
                    evidence: {type: "string" minLength: 1 maxLength: 260}
                    assignee: {type: "string" enum: ["user" "other" "unclear"]}
                }
            }}
            risk: {type: "string" enum: ["none" "caution" "high"]}
            evidence: {type: "string" maxLength: 1200}
            suspicious_links: {type: "string" maxLength: 1200}
        }}
}
fn take_answer(r){
    if !r.is_ok { return local_error(r.error) }
    if r.data != nil && r.data.output != nil && r.data.output.answer != nil {
        return r.data.output.answer
    }
    return "模型没有返回内容。"
}
fn refresh_provider(){
    ui.api_status.set_text(say("testing"))
    host.request("model.complete", {
        task: "Reply with the word ok."
        input: {ping: "ok"}
        schema: answer_schema()
        class: "fast"
    }, fn(s){
        if s.is_ok { ui.api_status.set_text(say("connected")) }
        else { ui.api_status.set_text(local_error(s.error)) }
    })
}
fn plan_schema(){
    return {type: "object" required: ["stop" "tools" "since" "until" "span" "to" "subject" "body" "query" "todo_id" "todo_title" "todo_deadline" "todo_deadline_mode" "answer"] additionalProperties: false
        properties: {
            stop: {type: "string" enum: ["continue" "Finish" "结束"]}
            tools: {type: "string" maxLength: 240}
            since: {type: "string" maxLength: 40}
            until: {type: "string" maxLength: 40}
            span: {type: "string" maxLength: 80}
            to: {type: "string" maxLength: 200}
            subject: {type: "string" maxLength: 300}
            body: {type: "string" maxLength: 4000}
            query: {type: "string" maxLength: 120}
            todo_id: {type: "integer"}
            todo_title: {type: "string" maxLength: 180}
            todo_deadline: {type: "string" maxLength: 100}
            todo_deadline_mode: {type: "string" enum: ["keep" "set" "clear"]}
            answer: {type: "string" maxLength: 4000}
        }}
}
fn event_schema(){
    return {type: "object" required: ["found" "title" "start" "end" "location" "start_ms" "end_ms" "timezone"] additionalProperties: false
        properties: {
            found: {type: "string" enum: ["yes" "no"]}
            title: {type: "string" maxLength: 200}
            start: {type: "string" maxLength: 80}
            end: {type: "string" maxLength: 80}
            location: {type: "string" maxLength: 200}
            start_ms: {type: "integer"}
            end_ms: {type: "integer"}
            timezone: {type: "string" maxLength: 80}
        }}
}
fn translate_schema(){
    return {type: "object" required: ["status" "subject" "text"] additionalProperties: false
        properties: {
            status: {type: "string" enum: ["translated" "already"]}
            subject: {type: "string" maxLength: 300}
            text: {type: "string" maxLength: 8000}
        }}
}
fn pack(text){
    if text == nil { return "" }
    let parts = text.split("\n")
    let out = ""
    for p in parts {
        let clean = p.replace("|", "/")
        if out != "" { out = out + "¬" }
        out = out + clean
    }
    return out
}
fn unpack(text){
    if text == nil { return "" }
    let parts = text.split("¬")
    let out = ""
    for p in parts {
        if out != "" { out = out + "\n" }
        out = out + p
    }
    return out
}
fn mail_key(){
    if reading == nil || account == nil { return "" }
    return account.id + "~" + folder.id + "~" + reading.id
}
fn summary_key(){
    let key = mail_key()
    if key == "" { return "" }
    return key + "~security-v1"
}
fn remember_sum(key, text){
    saved_sum[key] = text
    let found = false
    for k in sum_keys { if k == key { found = true } }
    if !found { sum_keys.push(key) }
}
fn remember_trans(key, lang, subject, text){
    saved_trans[key] = text
    saved_subject[key] = subject
    saved_trans_lang[key] = lang
    let found = false
    for k in trans_keys { if k == key { found = true } }
    if !found { trans_keys.push(key) }
}
fn action_key_checked(key){
    for k in action_checked_keys { if k == key { return true } }
    return false
}
fn mark_action_key_checked(key){
    if action_key_checked(key) { return }
    action_checked_keys.push(key)
}
fn action_status_ok(status){
    return status == "suggested" || status == "todo" || status == "done" || status == "ignored"
}
fn save_action_items(){
    fs.write("actions.json", {version: 1 next_id: next_action_id checked: action_checked_keys items: action_items}.to_json())
}
fn load_action_items(){
    action_items = []
    action_checked_keys = []
    next_action_id = 1
    if !fs.exists("actions.json") { return }
    try {
        let raw = fs.read("actions.json")
        let data = raw.parse_json()
        if data == nil || data.version != 1 || data.items == nil || !data.items.is_array() { return }
        if data.checked != nil && data.checked.is_array() {
            for key in data.checked {
                if key != nil && ("" + key) != "" && action_checked_keys.len() < 1000 {
                    action_checked_keys.push("" + key)
                }
            }
        }
        for item in data.items {
            if action_items.len() >= 1000 { break }
            if item == nil || item.id == nil || item.key == nil || item.title == nil || item.evidence == nil || item.status == nil { continue }
            let status = "" + item.status
            if !action_status_ok(status) { continue }
            let deadline = ""
            let account_id = ""
            let folder_id = "INBOX"
            let message_id = ""
            let subject = ""
            let sender = ""
            if item.deadline != nil { deadline = "" + item.deadline }
            if item.account != nil { account_id = "" + item.account }
            if item.folder != nil { folder_id = "" + item.folder }
            if item.message != nil { message_id = "" + item.message }
            if item.subject != nil { subject = "" + item.subject }
            if item.sender != nil { sender = "" + item.sender }
            // Backfill the real-date field for items saved before it existed;
            // reading a missing field is a script error, so every item must
            // carry it. iso_date_of only accepts absolute dates — a relative
            // word like "明天" from an old save must NOT resolve against today.
            action_items.push({id: item.id key: "" + item.key title: "" + item.title deadline: deadline due_date: iso_date_of(deadline) evidence: "" + item.evidence status: status account: account_id folder: folder_id message: message_id subject: subject sender: sender})
            if item.id >= next_action_id { next_action_id = item.id + 1 }
        }
        if data.next_id != nil && data.next_id > next_action_id { next_action_id = data.next_id }
    } catch {
        action_items = []
        action_checked_keys = []
        next_action_id = 1
    }
}
fn remove_actions_for(key){
    let kept = []
    for item in action_items { if item.key != key { kept.push(item) } }
    action_items = kept
}
fn remember_actions(key, items, source, account_id, folder_id, message_id, subject, sender){
    remove_actions_for(key)
    mark_action_key_checked(key)
    for item in items {
        let title = ("" + item.title).trim()
        let evidence = ("" + item.evidence).trim()
        let assignee = "" + item.assignee
        let deadline = ""
        if item.deadline != nil { deadline = ("" + item.deadline).trim() }
        // Only keep tasks assigned to this user and backed by an exact quote
        // from the open email. This rejects generic notices and model guesses.
        if assignee == "user" && title != "" && evidence != "" && source.search(evidence) >= 0 {
            action_items.push({id: next_action_id key: key title: title deadline: deadline due_date: normalize_deadline(deadline) evidence: evidence status: "suggested" account: account_id folder: folder_id message: message_id subject: subject sender: sender})
            next_action_id = next_action_id + 1
        }
    }
}
fn action_items_for(key){
    let out = []
    for item in action_items { if item.key == key { out.push(item) } }
    return out
}
fn visible_action_count(key){
    let n = 0
    for item in action_items {
        if item.key == key && item.status != "ignored" { n = n + 1 }
    }
    return n
}
fn pending_todo_count(){
    let n = 0
    for item in action_items { if item.status == "todo" { n = n + 1 } }
    return n
}
fn tracked_todo_count(){
    let n = 0
    for item in action_items { if item.status == "todo" || item.status == "done" { n = n + 1 } }
    return n
}
fn action_state_face(status){
    if status == "todo" { return say("todo_added") }
    if status == "done" { return say("todo_done") }
    if status == "ignored" { return say("tab_ignored") }
    return ""
}
// Real dates for deadlines: "明天"/"tomorrow" and friends resolve against
// today when the item is stored, so the list can tell overdue from pending.
fn pad2(n){
    let s = "" + n
    if s.len() < 2 { s = "0" + s }
    return s
}
fn stamp_of(epoch){
    let t = local_time(epoch)
    return "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day)
}
fn today_stamp(){ return stamp_of(time_now()) }
fn stamp_key(s){
    let p = s.split("-")
    if p.len() != 3 { return -1 }
    let y = round(p[0].trim().to_f64())
    let m = round(p[1].trim().to_f64())
    let d = round(p[2].trim().to_f64())
    if !(y >= 2000) || !(y <= 2100) { return -1 }
    if !(m >= 1) || !(m <= 12) { return -1 }
    if !(d >= 1) || !(d <= 31) { return -1 }
    return y * 10000 + m * 100 + d
}
fn iso_date_of(text){
    let head = text.trim()
    if head.search("T") > 0 { head = head.split("T")[0] }
    if head.search(" ") > 0 { head = head.split(" ")[0] }
    let p = head.split("-")
    if p.len() != 3 { p = head.split("/") }
    if p.len() != 3 { return "" }
    let y = round(p[0].trim().to_f64())
    let m = round(p[1].trim().to_f64())
    let d = round(p[2].trim().to_f64())
    if !(y >= 2000) || !(y <= 2100) { return "" }
    if !(m >= 1) || !(m <= 12) { return "" }
    if !(d >= 1) || !(d <= 31) { return "" }
    return "" + y + "-" + pad2(m) + "-" + pad2(d)
}
fn normalize_deadline(text){
    let t = text.trim()
    if t == "" { return "" }
    if t == "今天" || t == "today" || t == "Today" { return today_stamp() }
    if t == "明天" || t == "tomorrow" || t == "Tomorrow" { return stamp_of(time_now() + 86400) }
    if t == "后天" { return stamp_of(time_now() + 172800) }
    if t == "大后天" { return stamp_of(time_now() + 259200) }
    return iso_date_of(t)
}
fn refresh_todo_button(){
    let label = say("todos")
    let n = pending_todo_count()
    if n > 0 { label = label + " (" + n + ")" }
    ui.btn_todos.set_text(label)
}
fn set_action_status(id, state){
    if !action_status_ok(state) { return }
    for item in action_items { if item.id == id { item.status = state } }
    save_action_items()
    refresh_todo_button()
    ui.action_rows.render()
    ui.todo_rows.render()
    paint_mail()
}
fn todo_line(item){
    let text = "#" + item.id + " [" + item.status + "] " + item.title
    if item.deadline != "" { text = text + " — deadline: " + item.deadline }
    return text
}
fn tool_list_todos(){
    let text = "To-dos (including suggested items):"
    let n = 0
    for item in action_items {
        if item.status != "ignored" {
            text = text + "\n" + todo_line(item)
            n = n + 1
        }
    }
    if n == 0 { text = "There are no to-dos or suggestions." }
    finish_tool(text)
}
fn save_todo_changes(){
    save_action_items()
    refresh_todo_button()
    ui.action_rows.render()
    ui.todo_rows.render()
    paint_mail()
}
fn tool_add_todo(){
    let id = arg_todo_id
    if id > 0 {
        for item in action_items {
            if item.id == id {
                if item.status == "suggested" {
                    item.status = "todo"
                    save_todo_changes()
                    finish_tool("Added suggested item " + todo_line(item) + " to the to-do list.")
                    return
                }
                if item.status == "todo" { finish_tool("That item is already in the to-do list: " + todo_line(item)); return }
                if item.status == "done" { finish_tool("That item is completed. Use reopen_todo if the user wants it active again: " + todo_line(item)); return }
                finish_tool("That item is ignored and cannot be added until it is created again.")
                return
            }
        }
        finish_tool("No to-do has id #" + id + ". Call list_todos before changing an existing item.")
        return
    }
    let title = arg_todo_title.trim()
    if title == "" { finish_tool("Refused: a new to-do needs a title in todo_title."); return }
    let deadline = arg_todo_deadline.trim()
    let subject = "Manual to-do"
    let sender = "AgentMail"
    let message = ""
    if reading != nil {
        subject = reading.subject
        sender = reading.sender
        message = reading.id
    }
    let account_id = ""
    if account != nil { account_id = account.id }
    let item = {id: next_action_id key: "manual:" + next_action_id title: clip(title, 180) deadline: clip(deadline, 100) due_date: normalize_deadline(deadline) evidence: "Created from the user's request in AgentMail." status: "todo" account: account_id folder: folder.id message: message subject: subject sender: sender}
    action_items.push(item)
    next_action_id = next_action_id + 1
    save_todo_changes()
    finish_tool("Created " + todo_line(item) + ".")
}
fn tool_update_todo(){
    let id = arg_todo_id
    if id <= 0 { finish_tool("Refused: update_todo needs the exact todo_id. Call list_todos if the item is not clear."); return }
    let title = arg_todo_title.trim()
    let deadline = arg_todo_deadline.trim()
    if arg_todo_deadline_mode == "set" && deadline == "" { finish_tool("Refused: a deadline set needs a non-empty todo_deadline. Use clear to remove it."); return }
    let found = false
    let changed = false
    let shown = ""
    for item in action_items {
        if item.id == id && item.status != "ignored" {
            found = true
            if title != "" && title != item.title { item.title = clip(title, 180); changed = true }
            if arg_todo_deadline_mode == "set" && deadline != item.deadline { item.deadline = clip(deadline, 100); item.due_date = normalize_deadline(deadline); changed = true }
            if arg_todo_deadline_mode == "clear" && item.deadline != "" { item.deadline = ""; item.due_date = ""; changed = true }
            shown = todo_line(item)
        }
    }
    if !found { finish_tool("No active to-do has id #" + id + ". Call list_todos before changing an existing item."); return }
    if !changed { finish_tool("No change was made to " + shown + "."); return }
    save_todo_changes()
    finish_tool("Updated " + shown + ".")
}
fn tool_complete_todo(){
    let id = arg_todo_id
    if id <= 0 { finish_tool("Refused: complete_todo needs the exact todo_id. Call list_todos if the item is not clear."); return }
    for item in action_items {
        if item.id == id {
            if item.status == "todo" {
                item.status = "done"
                save_todo_changes()
                finish_tool("Completed " + todo_line(item) + ".")
                return
            }
            if item.status == "done" { finish_tool("That item is already completed: " + todo_line(item)); return }
            finish_tool("Only an active to-do can be completed. Use add_todo first for a suggestion.")
            return
        }
    }
    finish_tool("No to-do has id #" + id + ". Call list_todos before changing an existing item.")
}
fn tool_reopen_todo(){
    let id = arg_todo_id
    if id <= 0 { finish_tool("Refused: reopen_todo needs the exact todo_id. Call list_todos if the item is not clear."); return }
    for item in action_items {
        if item.id == id {
            if item.status == "done" {
                item.status = "todo"
                save_todo_changes()
                finish_tool("Reopened " + todo_line(item) + ".")
                return
            }
            if item.status == "todo" { finish_tool("That item is already active: " + todo_line(item)); return }
            finish_tool("Only a completed to-do can be reopened.")
            return
        }
    }
    finish_tool("No to-do has id #" + id + ". Call list_todos before changing an existing item.")
}
fn tool_delete_todo(){
    let id = arg_todo_id
    if id <= 0 { finish_tool("Refused: delete_todo needs the exact todo_id. Call list_todos if the item is not clear."); return }
    let kept = []
    let removed = ""
    for item in action_items {
        if item.id == id { removed = todo_line(item) }
        else { kept.push(item) }
    }
    if removed == "" { finish_tool("No to-do has id #" + id + ". Call list_todos before changing an existing item."); return }
    action_items = kept
    save_todo_changes()
    finish_tool("Deleted " + removed + ".")
}
fn load_tools(){
    if fs.exists("lang.txt") {
        let line = fs.read("lang.txt").trim()
        let other = line.strip_prefix("other|")
        if other != line {
            lang_is_other = true
            custom_lang = other
            if other != "" { target_lang = other }
        } else if line != "" {
            if known_lang(line) {
                lang_is_other = false
                target_lang = line
            } else {
                lang_is_other = true
                custom_lang = line
                target_lang = line
            }
        }
    }
    if !fs.exists("tools.txt") { return }
    let lines = fs.read("tools.txt").split("\n")
    for line in lines {
        if line.search("S|") == 0 {
            let bits = line.strip_prefix("S|").split("|")
            if bits.len() >= 2 { remember_sum(bits[0], unpack(bits[1])) }
        }
        if line.search("T|") == 0 {
            let bits = line.strip_prefix("T|").split("|")
            if bits.len() >= 4 { remember_trans(bits[0], bits[1], unpack(bits[2]), unpack(bits[3])) }
        }
    }
}
fn known_lang(name){
    for label in lang_labels {
        if label == name && name != "Others" { return true }
    }
    return false
}
fn refresh_lang_face(){
    let shown = target_lang
    if lang_is_other { shown = "Others" }
    ui.lang_name.set_text(shown)
    if lang_open { ui.lang_mark.set_text("▴") }
    else { ui.lang_mark.set_text("▾") }
}
fn toggle_lang_menu(){
    lang_open = !lang_open
    if lang_open { sys_open = false; ui.sys_menu.set_visible(false); refresh_sys_face() }
    ui.lang_menu.set_visible(lang_open)
    refresh_lang_face()
}
