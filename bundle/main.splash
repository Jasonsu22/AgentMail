    ui.list_pane.set_visible(false)
    ui.reader.set_visible(false)
    ui.composer.set_visible(false)
    ui.settings_pane.set_visible(false)
    ui.confirm.set_visible(false)
    ui.todos_pane.set_visible(true)
    ui.todos_hint.set_text(say("todo_hint"))
